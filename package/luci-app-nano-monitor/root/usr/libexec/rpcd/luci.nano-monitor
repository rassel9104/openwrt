#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (C) 2026 RaykTo <raktodev@gmail.com>

. /lib/functions.sh
. /usr/share/libubox/jshn.sh
. /usr/libexec/nano-monitor/device-policy

WORK_DIR='/var/run/nano-monitor'
LOCK_DIR="$WORK_DIR/lock"
PID_FILE="$WORK_DIR/pid"
HELPER='/usr/libexec/nano-monitor/run-speedtest'
SHAPER_STATE_DIR='/var/run/nano-shaper'
ACCOUNT_STATE_DIR='/var/run/nano-accounting'
ACCOUNT_SNAPSHOT="$ACCOUNT_STATE_DIR/current-snapshot"
MIGRATION_FILE='/etc/nano-monitor/v4-migration'
DEVICE_REGISTRY='/usr/libexec/nano-monitor/device-registry'
RECONCILE='/etc/hotplug.d/dhcp/95-nano-shaper'
WAN_HANDLE=1001
LAN_HANDLE=1002
OWNER_CLASS=4095
SLOW_OFFSET=1000

is_uint() {
	case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

uint_mul() {
	awk -v a="$1" -v b="$2" 'BEGIN { printf "%.0f", a * b }'
}

uint_sub_floor() {
	awk -v a="$1" -v b="$2" 'BEGIN { printf "%.0f", (a > b ? a - b : 0) }'
}

uint_ge() {
	awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'
}

effective_flow_offloading_disabled() {
	local rules
	rules="$(nft list ruleset 2>/dev/null)" || return 1
	! printf '%s\n' "$rules" | grep -Eq '(^|[[:space:]])flowtable[[:space:]]|flow add @'
}

json_error() {
	json_init
	json_add_string ok '0'
	json_add_string error "$1"
	json_dump
	json_cleanup
}

prepare_work_dir() {
	[ ! -L "$WORK_DIR" ] || return 1
	if [ -e "$WORK_DIR" ]; then
		[ -d "$WORK_DIR" ] || return 1
	else
		mkdir -m 0700 "$WORK_DIR" || return 1
	fi
	chmod 0700 "$WORK_DIR"
}

validate_input() {
	local input keys key
	input="$(cat)"
	json_load "$input" 2>/dev/null || {
		json_error 'Solicitud JSON no válida.'
		return 1
	}
	json_get_keys keys
	for key in $keys; do
		[ "$key" = 'ubus_rpc_session' ] || {
			json_error "Argumento no permitido: $key"
			json_cleanup
			return 1
		}
	done
	json_cleanup
	return 0
}

read_value() {
	local file="$1" default="$2" value
	if [ -f "$WORK_DIR/$file" ]; then
		value="$(cat "$WORK_DIR/$file" 2>/dev/null)"
		printf '%s' "$value"
	else
		printf '%s' "$default"
	fi
}

method_status() {
	local profile state pid
	config_load nano-monitor
	config_get profile main profile 'balanced'
	state="$(read_value state idle)"
	pid="$(read_value pid '')"

	json_init
	json_add_string provider 'Cloudflare'
	json_add_string profile "$profile"
	json_add_string state "$state"
	json_add_string pid "$pid"
	json_add_string message "$(read_value message '')"
	json_add_string latency_ms "$(read_value latency_ms '')"
	json_add_string download_json "$(read_value download.json '')"
	json_add_string upload_json "$(read_value upload.json '')"
	json_add_string download_error "$(read_value download.error '')"
	json_add_string upload_error "$(read_value upload.error '')"
	json_dump
	json_cleanup
}

method_start() {
	local profile pid
	config_load nano-monitor
	config_get profile main profile 'balanced'
	case "$profile" in
		quick|balanced|accurate) ;;
		*) json_error 'El perfil de prueba no es válido.'; return ;;
	esac

	prepare_work_dir || {
		json_error 'No se pudo crear el directorio temporal.'
		return
	}

	if ! mkdir "$LOCK_DIR" 2>/dev/null; then
		pid="$(cat "$PID_FILE" 2>/dev/null)"
		case "$pid" in
			''|*[!0-9]*) ;;
			*)
				if [ "$pid" -gt 1 ] 2>/dev/null && kill -0 "$pid" 2>/dev/null; then
					json_error 'Ya hay una prueba en curso.'
					return
				fi
				;;
		esac
		rm -f "$PID_FILE"
		rmdir "$LOCK_DIR" 2>/dev/null
		mkdir "$LOCK_DIR" 2>/dev/null || {
			json_error 'Ya hay una prueba en curso.'
			return
		}
	fi

	printf '%s\n' 'queued' > "$WORK_DIR/state"
	printf '%s\n' 'Prueba en cola…' > "$WORK_DIR/message"
	"$HELPER" "$profile" >/dev/null 2>&1 &
	pid=$!
	printf '%s\n' "$pid" > "$PID_FILE"

	json_init
	json_add_string ok '1'
	json_add_string state 'queued'
	json_add_string provider 'Cloudflare'
	json_add_string pid "$pid"
	json_dump
	json_cleanup
}

nft_counter_bytes() {
	local value
	value="$(nft -j list counter inet nano_accounting "$1" 2>/dev/null | jsonfilter -e '@.nftables[*].counter.bytes' 2>/dev/null)"
	is_uint "$value" || return 1
	printf '%s' "$value"
}

nft_quota_used() {
	local id="$1" value
	case "$id" in ????????????) ;; *) return 1 ;; esac
	value="$(nft -j list quota inet nano_accounting "q_$id" 2>/dev/null | jsonfilter -e '@.nftables[*].quota.used' 2>/dev/null)"
	is_uint "$value" || return 1
	printf '%s' "$value"
}

nft_quota_bytes() {
	local id="$1" value
	case "$id" in ????????????) ;; *) return 1 ;; esac
	value="$(nft -j list quota inet nano_accounting "q_$id" 2>/dev/null | jsonfilter -e '@.nftables[*].quota.bytes' 2>/dev/null)"
	is_uint "$value" || return 1
	printf '%s' "$value"
}

rpc_nft_topology_fingerprint() {
	local table="$1" rules
	rules="$(nft list table inet "$table" 2>/dev/null)" || return 1
	printf '%s\n' "$rules" |
		awk '
		function size_unit(unit) {
			return unit == "bytes" || unit == "kbytes" || unit == "mbytes" || unit == "gbytes"
		}
		function size_bytes(value, unit, factor) {
			factor = 1
			if (unit == "kbytes") factor = 1024
			else if (unit == "mbytes") factor = 1024 * 1024
			else if (unit == "gbytes") factor = 1024 * 1024 * 1024
			return value * factor
		}
		{
			if ($0 ~ /^[[:space:]]*quota[[:space:]]+q_[^[:space:]]+[[:space:]]+\{$/)
				in_quota = 1
			gsub(/packets [0-9]+ bytes [0-9]+/, "packets <runtime> bytes <runtime>")
			if (in_quota && $1 ~ /^[0-9]+$/ && size_unit($2) &&
				(NF == 2 || (NF == 5 && $3 == "used" && $4 ~ /^[0-9]+$/ && size_unit($5)))) {
				indent = $0
				sub(/[0-9].*$/, "", indent)
				printf "%s%.0f bytes\n", indent, size_bytes($1, $2)
				next
			}
			print
			if (in_quota && $0 ~ /^[[:space:]]*\}[[:space:]]*$/)
				in_quota = 0
		}' |
		sha256sum | awk '{ print $1 }'
}

rpc_tc_topology_fingerprint() {
	local dev="$1" qdisc classes
	case "$dev" in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; esac
	qdisc="$(tc qdisc show dev "$dev" 2>/dev/null)" || return 1
	classes="$(tc class show dev "$dev" 2>/dev/null)" || return 1
	# Match nano-shaper's canonical topology: runtime counters and kernel leaf
	# identifiers must not invalidate an otherwise unchanged live readback.
	qdisc="$(printf '%s\n' "$qdisc" |
		awk '{ gsub(/direct_packets_stat [0-9]+/, "direct_packets_stat <runtime>"); print }' |
		sort)" || return 1
	classes="$(printf '%s\n' "$classes" |
		awk '/^class htb / { gsub(/ leaf [^ ]+/, " leaf <qdisc>"); print }' |
		sort)" || return 1
	[ -n "$qdisc" ] && [ -n "$classes" ] || return 1
	printf 'qdisc=%s\nclasses=%s\n' "$qdisc" "$classes" | sha256sum | awk '{ print $1 }'
}

runtime_accounting_ok() {
	local rules lan_if wan_network wan_if ip expected="$1" expected_topology="$2" actual configured registry tab id mac name period_day other_down other_up total_down total_up degraded expected_priority_sorted live_priority_sorted
	[ "$(cat "$ACCOUNT_STATE_DIR/state" 2>/dev/null)" = 'active' ] || return 1
	! nft list table inet nano_release_gate >/dev/null 2>&1 || return 1
	! nft list table inet nano_accounting_reset_gate >/dev/null 2>&1 || return 1
	! nft list table inet nano_shaper_gate >/dev/null 2>&1 || return 1
	config_load bwlimit
	[ "$(uci -q get bwlimit.main.quota_enabled)" = '1' ] || return 1
	config_get lan_if main lan_if 'br-lan'
	config_get wan_network main wan_network 'provider'
	config_get configured main quota_per_device_bytes '700000000'
	config_get other_down main other_down_kbit '768'
	config_get other_up main other_up_kbit '128'
	config_get total_down main total_down_kbit '8800'
	config_get total_up main total_up_kbit '4200'
	config_get degraded main other_degraded_kbit '64'
	[ -n "$expected" ] && configured="$expected"
	is_uint "$configured" || return 1
	wan_if="$(ubus call "network.interface.$wan_network" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
	rules="$(nft list table inet nano_accounting 2>/dev/null)" || return 1
	[ "${#expected_topology}" = '64' ] || return 1
	case "$expected_topology" in *[!0-9a-f]*) return 1 ;; esac
	[ "$(rpc_nft_topology_fingerprint nano_accounting)" = "$expected_topology" ] || return 1
	printf '%s\n' "$rules" | grep -Fq 'comment "nano-monitor-accounting-v1"' || return 1
	expected_priority_sorted="$(priority_words_sorted "$(uci -q get bwlimit.main.exempt_ip)")" || return 1
	live_priority_sorted="$(nft_priority_words_sorted nano_accounting)" || return 1
	[ -n "$expected_priority_sorted" ] && [ "$live_priority_sorted" = "$expected_priority_sorted" ] || return 1
	printf '%s\n' "$rules" | grep -Fq "iifname \"$lan_if\" oifname \"$wan_if\"" || return 1
	printf '%s\n' "$rules" | grep -Fq "iifname \"$wan_if\" oifname \"$lan_if\"" || return 1
	for ip in $(uci -q get bwlimit.main.exempt_ip); do
		printf '%s\n' "$rules" | grep -Fq "$ip" || return 1
	done
	[ -x "$DEVICE_REGISTRY" ] || return 1
	registry="$($DEVICE_REGISTRY)" || return 1
	period_day="$(sed -n 's/^day=//p' "$ACCOUNT_SNAPSHOT" 2>/dev/null | sed -n '1p')"
	case "$period_day" in ????-??-??) ;; *) return 1 ;; esac
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] && continue
		load_device_policy "$id" "$mac" "$period_day" "$configured" "$other_down" "$other_up" "$total_down" "$total_up" "$degraded" || return 1
		actual="$(nft_quota_bytes "$id")" || return 1
		[ "$actual" = "$POLICY_LIMIT_BYTES" ] || return 1
		printf '%s\n' "$rules" | grep -Fq "q_$id" || return 1
	done <<EOF
$registry
EOF
	[ "$(uci -q get system.@system[0].zonename)" = 'America/New_York' ] || return 1
	[ "$(uci -q get system.@system[0].timezone)" = 'EST5EDT,M3.2.0,M11.1.0' ] || return 1
	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = '0' ] || return 1
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = '0' ] || return 1
	effective_flow_offloading_disabled || return 1
	if [ -n "$expected" ]; then
		[ "$(uci -q get bwlimit.main.quota_per_device_bytes)" = "$expected" ] || return 1
	fi
}

runtime_accounting_live_registry() {
	local snapshot_registry="$1" configured="$2" period_day="$3" expected_topology="$4" live tab id mac ip name row marker sid smac sip sname sused slimit sbonus sdown sup actual count=0 snapshot_count
	runtime_accounting_ok "$configured" "$expected_topology" || return 1
	[ -x "$DEVICE_REGISTRY" ] || return 1
	live="$($DEVICE_REGISTRY)" || return 1
	snapshot_count="$(printf '%s\n' "$snapshot_registry" | awk 'NF { count++ } END { print count + 0 }')"
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] && continue
		row="$(printf '%s\n' "$snapshot_registry" | awk -F '\t' -v wanted="$id" '$1 == wanted { print }')"
		[ "$(printf '%s\n' "$row" | awk 'NF { count++ } END { print count + 0 }')" = '1' ] || return 1
		IFS="$tab" read -r sid smac sip sname sused slimit sbonus sdown sup <<EOF
$row
EOF
		[ "$sid" = "$id" ] && [ "$smac" = "$mac" ] && [ "$sip" = "$ip" ] && [ "$sname" = "$name" ] || return 1
		for marker in "$sused" "$slimit" "$sbonus" "$sdown" "$sup"; do is_uint "$marker" || return 1; done
		load_device_policy "$id" "$mac" "$period_day" "$configured" "$configured_down" "$configured_up" "$configured_total_down" "$configured_total_up" "$configured_degraded" || return 1
		[ "$slimit" = "$POLICY_LIMIT_BYTES" ] && [ "$sbonus" = "$POLICY_BONUS_BYTES" ] && [ "$sdown" = "$POLICY_DOWN_KBIT" ] && [ "$sup" = "$POLICY_UP_KBIT" ] || return 1
		actual="$(nft_quota_bytes "$id")" || return 1
		[ "$actual" = "$slimit" ] || return 1
		actual="$(nft_quota_used "$id")" || return 1
		uint_ge "$actual" "$sused" || return 1
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$mac" "$ip" "$name" "$actual" "$slimit" "$sbonus" "$sdown" "$sup"
		count=$((count + 1))
	done <<EOF
$live
EOF
	[ "$count" = "$snapshot_count" ]
}

runtime_accounting_live_counters() {
	local name snapshot live output=''
	for name in internet_up internet_down priority_up priority_down others_up others_down; do
		case "$name" in
			internet_up) snapshot="$1" ;;
			internet_down) snapshot="$2" ;;
			priority_up) snapshot="$3" ;;
			priority_down) snapshot="$4" ;;
			others_up) snapshot="$5" ;;
			others_down) snapshot="$6" ;;
		esac
		is_uint "$snapshot" || return 1
		live="$(nft_counter_bytes "$name")" || return 1
		uint_ge "$live" "$snapshot" || return 1
		output="${output}${output:+ }$live"
	done
	printf '%s\n' "$output"
}

wait_accounting_quota() {
	local expected="$1" attempt=0 topology
	while [ "$attempt" -lt 15 ]; do
		topology="$(sed -n 's/^topology_sha256=//p' "$ACCOUNT_SNAPSHOT" 2>/dev/null | sed -n '1p')"
		runtime_accounting_ok "$expected" "$topology" && return 0
		attempt=$((attempt + 1))
		[ "$attempt" -ge 15 ] || sleep 1
	done
	return 1
}

reconcile_accounting_quota() {
	local expected="$1" attempt=0
	while [ "$attempt" -lt 2 ]; do
		if "$RECONCILE" reconcile 6>&- >/dev/null 2>&1 && wait_accounting_quota "$expected"; then
			return 0
		fi
		attempt=$((attempt + 1))
	done
	return 1
}

restore_quota_value() {
	local value="$1"
	uci -q set bwlimit.main.quota_per_device_bytes="$value" || return 1
	uci -q commit bwlimit || return 1
	[ "$(uci -q get bwlimit.main.quota_per_device_bytes)" = "$value" ] || return 1
	reconcile_accounting_quota "$value"
}

method_accounting() {
	local internet_up=0 internet_down=0 priority_up=0 priority_down=0 others_up=0 others_down=0 quota_bytes=700000000 quota_enabled=0 migration_hold=0 quota_used remaining verified period_day timezone reset_hour=0 reset_minute=1 reset_at data_ok=1 value registry live_registry live_counters topology_sha256 tab id mac ip name used limit bonus down up left degraded device_count capacity bonus_total degraded_count account_state account_message updated_at verified_at now age snapshot line configured_quota configured_enabled configured_reset_hour configured_reset_minute configured_down configured_up configured_total_down configured_total_up configured_degraded generation_before generation_after generation_live verified_candidate=0
	config_load bwlimit
	config_get_bool configured_enabled main quota_enabled 1
	config_get configured_quota main quota_per_device_bytes '700000000'
	config_get configured_reset_hour main quota_reset_hour '0'
	config_get configured_reset_minute main quota_reset_minute '1'
	config_get configured_down main other_down_kbit '768'
	config_get configured_up main other_up_kbit '128'
	config_get configured_total_down main total_down_kbit '8800'
	config_get configured_total_up main total_up_kbit '4200'
	config_get configured_degraded main other_degraded_kbit '64'
	[ -f "$ACCOUNT_SNAPSHOT" ] && [ ! -L "$ACCOUNT_SNAPSHOT" ] || data_ok=0
	generation_before="$(cat "$ACCOUNT_STATE_DIR/generation" 2>/dev/null)"
	account_state="$(cat "$ACCOUNT_STATE_DIR/state" 2>/dev/null)"
	account_message="$(cat "$ACCOUNT_STATE_DIR/message" 2>/dev/null)"
	snapshot="$(cat "$ACCOUNT_SNAPSHOT" 2>/dev/null)" || data_ok=0
	generation_after="$(cat "$ACCOUNT_STATE_DIR/generation" 2>/dev/null)"
	is_uint "$generation_before" && [ $((generation_before % 2)) -eq 0 ] && [ "$generation_before" = "$generation_after" ] || data_ok=0
	registry=''
	tab="$(printf '\t')"
	while IFS= read -r line; do
		case "$line" in
			updated_at=*) updated_at="${line#*=}" ;;
			verified_at=*) verified_at="${line#*=}" ;;
			day=*) period_day="${line#*=}" ;;
			quota_enabled=*) quota_enabled="${line#*=}" ;;
			quota_bytes=*) quota_bytes="${line#*=}" ;;
			migration_hold=*) migration_hold="${line#*=}" ;;
			reset_hour=*) reset_hour="${line#*=}" ;;
			reset_minute=*) reset_minute="${line#*=}" ;;
			topology_sha256=*) topology_sha256="${line#*=}" ;;
			internet_up=*) internet_up="${line#*=}" ;;
			internet_down=*) internet_down="${line#*=}" ;;
			priority_up=*) priority_up="${line#*=}" ;;
			priority_down=*) priority_down="${line#*=}" ;;
			others_up=*) others_up="${line#*=}" ;;
			others_down=*) others_down="${line#*=}" ;;
			device"$tab"*) registry="${registry}${registry:+
}${line#device$tab}" ;;
		esac
	done <<EOF
$snapshot
EOF
	for value in internet_up internet_down priority_up priority_down others_up others_down; do
		eval "used=\${$value}"
		is_uint "$used" || { eval "$value=0"; data_ok=0; }
	done
	is_uint "$quota_bytes" && uint_ge "$quota_bytes" 100000000 && uint_ge 1000000000000 "$quota_bytes" || { quota_bytes=700000000; data_ok=0; }
	[ "$quota_enabled" = '1' ] || data_ok=0
	case "$migration_hold" in 0|1) ;; *) migration_hold=0; data_ok=0 ;; esac
	is_uint "$reset_hour" && is_uint "$reset_minute" && [ "$reset_hour" -le 23 ] && [ "$reset_minute" -le 59 ] || { reset_hour=0; reset_minute=1; data_ok=0; }
	[ "$configured_enabled" = "$quota_enabled" ] && [ "$configured_quota" = "$quota_bytes" ] && [ "$configured_reset_hour" = "$reset_hour" ] && [ "$configured_reset_minute" = "$reset_minute" ] || data_ok=0
	case "$period_day" in ????-??-??) ;; *) period_day="$(date +%F)"; data_ok=0 ;; esac
	if is_uint "$updated_at"; then
		now="$(date +%s)"
		age=$((now - updated_at))
		[ "$age" -ge 0 ] && [ "$age" -le 60 ] || data_ok=0
	else
		data_ok=0
	fi
	if is_uint "$verified_at"; then
		age=$((now - verified_at))
		[ "$age" -ge 0 ] && [ "$age" -le 360 ] || data_ok=0
	else
		data_ok=0
	fi
	if [ "$data_ok" = '1' ] && [ "$account_state" = 'active' ]; then
		if live_registry="$(runtime_accounting_live_registry "$registry" "$quota_bytes" "$period_day" "$topology_sha256")" &&
			live_counters="$(runtime_accounting_live_counters "$internet_up" "$internet_down" "$priority_up" "$priority_down" "$others_up" "$others_down")"; then
			registry="$live_registry"
			set -- $live_counters
			[ "$#" = '6' ] && internet_up="$1" && internet_down="$2" && priority_up="$3" && priority_down="$4" && others_up="$5" && others_down="$6" && verified_candidate=1
		fi
	fi
	quota_used=0
	remaining=0
	capacity=0
	bonus_total=0
	device_count=0
	degraded_count=0
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name used limit bonus down up; do
		[ -z "$id" ] && continue
		is_uint "$used" || { used=0; data_ok=0; }
		is_uint "$limit" || { limit="$quota_bytes"; data_ok=0; }
		is_uint "$bonus" || { bonus=0; data_ok=0; }
		is_uint "$down" || { down="$configured_down"; data_ok=0; }
		is_uint "$up" || { up="$configured_up"; data_ok=0; }
		left="$(uint_sub_floor "$limit" "$used")"
		quota_used="$(awk -v a="$quota_used" -v b="$used" 'BEGIN { printf "%.0f", a + b }')"
		remaining="$(awk -v a="$remaining" -v b="$left" 'BEGIN { printf "%.0f", a + b }')"
		capacity="$(awk -v a="$capacity" -v b="$limit" 'BEGIN { printf "%.0f", a + b }')"
		bonus_total="$(awk -v a="$bonus_total" -v b="$bonus" 'BEGIN { printf "%.0f", a + b }')"
		device_count=$((device_count + 1))
		if [ "$migration_hold" = '1' ] || uint_ge "$used" "$limit"; then
			degraded_count=$((degraded_count + 1))
		fi
	done <<EOF
$registry
EOF
	verified='0'
	if [ "$verified_candidate" = '1' ] && transition_gates_absent; then
		generation_live="$(cat "$ACCOUNT_STATE_DIR/generation" 2>/dev/null)"
		[ "$generation_live" = "$generation_before" ] && is_uint "$generation_live" && [ $((generation_live % 2)) -eq 0 ] && verified='1'
	fi
	timezone="$(uci -q get system.@system[0].zonename)"
	reset_at="$(printf '%02d:%02d' "$reset_hour" "$reset_minute" 2>/dev/null)"
	[ -n "$reset_at" ] || reset_at='00:01'

	json_init
	json_add_string verified "$verified"
	json_add_string state "$account_state"
	json_add_string message "$account_message"
	json_add_string period_day "$period_day"
	json_add_string timezone "${timezone:-sistema local}"
	json_add_string reset_at "$reset_at"
	json_add_string quota_enabled "$quota_enabled"
	json_add_string quota_bytes "$quota_bytes"
	json_add_string migration_hold "$migration_hold"
	json_add_string quota_capacity "$capacity"
	json_add_string quota_bonus_total "$bonus_total"
	json_add_string default_down_kbit "$configured_down"
	json_add_string default_up_kbit "$configured_up"
	json_add_string max_down_kbit "$configured_total_down"
	json_add_string max_up_kbit "$configured_total_up"
	json_add_string degraded_kbit "$configured_degraded"
	json_add_string quota_used "$quota_used"
	json_add_string quota_remaining "$remaining"
	json_add_string blocked '0'
	json_add_string degraded_count "$degraded_count"
	json_add_string device_count "$device_count"
	json_add_string internet_up "$internet_up"
	json_add_string internet_down "$internet_down"
	json_add_string priority_up "$priority_up"
	json_add_string priority_down "$priority_down"
	json_add_string others_up "$others_up"
	json_add_string others_down "$others_down"
	json_add_array devices
	while IFS="$tab" read -r id mac ip name used limit bonus down up; do
		[ -z "$id" ] && continue
		is_uint "$used" || used=0
		is_uint "$limit" || limit="$quota_bytes"
		is_uint "$bonus" || bonus=0
		is_uint "$down" || down="$configured_down"
		is_uint "$up" || up="$configured_up"
		left="$(uint_sub_floor "$limit" "$used")"
		degraded='0'
		if [ "$migration_hold" = '1' ] || uint_ge "$used" "$limit"; then degraded='1'; fi
		json_add_object ''
		json_add_string id "$id"
		json_add_string mac "$mac"
		json_add_string ip "$ip"
		json_add_string name "$name"
		json_add_string used "$used"
		json_add_string limit_bytes "$limit"
		json_add_string bonus_bytes "$bonus"
		json_add_string remaining "$left"
		json_add_string degraded "$degraded"
		json_add_string down_kbit "$down"
		json_add_string up_kbit "$up"
		json_close_object
	done <<EOF
$registry
EOF
	json_close_array
	json_dump
	json_cleanup
}

add_priority_json() {
	json_add_string '' "$1"
}

tc_class_value_matches() {
	local dev="$1" classid="$2" field="$3" expected="$4" actual
	actual="$(tc -j class show dev "$dev" classid "$classid" 2>/dev/null | jsonfilter -e "@[0].$field" 2>/dev/null)"
	[ "$actual" = "$expected" ]
}

tc_root_default_ok() {
	local dev="$1" handle="$2" root
	root="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n "/qdisc htb $handle: root/{p;q;}")"
	[ -n "$root" ] || return 1
	printf '%s\n' "$root" | grep -Eq 'default (20|0x20)( |$)'
}

collect_rpc_reservation() {
	local section="$1" ip mac
	config_get ip "$section" ip
	config_get mac "$section" mac
	if [ -n "$ip" ] && [ -n "$mac" ]; then
		RPC_RESERVED_IPS="$RPC_RESERVED_IPS $ip "
		rpc_add_other_ip "$ip"
	fi
}

rpc_is_priority_ip() {
	case " $RPC_PRIORITY_IPS " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

rpc_add_other_ip() {
	local ip="$1"
	case "$ip" in ''|*[!0-9.]*) return ;; esac
	rpc_is_priority_ip "$ip" && return
	case " $RPC_OTHER_IPS " in *" $ip "*) return ;; esac
	RPC_OTHER_IPS="${RPC_OTHER_IPS}${RPC_OTHER_IPS:+ }$ip"
}

runtime_reservations_ok() {
	local priority_ips ip valid=1 registry tab id mac name
	priority_ips="$(uci -q get bwlimit.main.exempt_ip)"
	[ -n "$priority_ips" ] || return 1
	RPC_PRIORITY_IPS="$priority_ips"
	RPC_RESERVED_IPS=''
	RPC_OTHER_IPS=''
	config_load dhcp
	config_foreach collect_rpc_reservation host
	for ip in $priority_ips; do
		case "$RPC_RESERVED_IPS" in *" $ip "*) ;; *) valid=0 ;; esac
	done
	[ -x "$DEVICE_REGISTRY" ] || return 1
	registry="$($DEVICE_REGISTRY)" || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] || rpc_add_other_ip "$ip"
	done <<EOF
$registry
EOF
	config_load bwlimit
	[ "$valid" = '1' ]
}

priority_words_sorted() {
	for ip in $1; do printf '%s\n' "$ip"; done | sort -u | awk 'NF { values = values (values ? " " : "") $0 } END { print values }'
}

nft_priority_words_sorted() {
	local table="$1"
	nft -j list set inet "$table" priority_v4 2>/dev/null |
		jsonfilter -e '@.nftables[*].set.elem[*]' 2>/dev/null |
		sort -u | awk 'NF { values = values (values ? " " : "") $0 } END { print values }'
}

rpc_release_gate_ok() {
	local lan_if="$1" wan_if="$2" actual expected
	actual="$(nft list table inet nano_release_gate 2>/dev/null |
		awk '{ gsub(/packets [0-9]+ bytes [0-9]+/, "packets <runtime> bytes <runtime>"); print }' |
		sha256sum | awk '{ print $1 }')" || return 1
	expected="$({
		printf 'table inet nano_release_gate {\n'
		printf '\tcomment "nano-monitor-release-v1"\n'
		printf '\tchain freeze_forward {\n'
		printf '\t\ttype filter hook forward priority filter - 7; policy accept;\n'
		printf '\t\tiifname "%s" oifname "%s" counter packets <runtime> bytes <runtime> drop\n' "$lan_if" "$wan_if"
		printf '\t\tiifname "%s" oifname "%s" counter packets <runtime> bytes <runtime> drop\n' "$wan_if" "$lan_if"
		printf '\t}\n}\n'
	} | sha256sum | awk '{ print $1 }')" || return 1
	[ -n "$expected" ] && [ "$actual" = "$expected" ]
}

rpc_shaper_gates_ok() {
	local lan_if="$1" wan_if="$2"
	! nft list table inet nano_shaper_gate >/dev/null 2>&1 || return 1
	! nft list table inet nano_accounting_reset_gate >/dev/null 2>&1 || return 1
	if [ "${NANO_RELEASE_READBACK:-0}" = '1' ]; then
		rpc_release_gate_ok "$lan_if" "$wan_if"
	else
		! nft list table inet nano_release_gate >/dev/null 2>&1
	fi
}

rpc_ipv4_hex() {
	awk -F. '{ printf "%02x%02x%02x%02x", $1, $2, $3, $4 }' <<EOF
$1
EOF
}

rpc_filter_mapping_matches() {
	local dev="$1" handle="$2" classid="$3" direction="$4" ip="$5" offset output hex
	[ "$direction" = 'src' ] && offset=12 || offset=16
	hex="$(rpc_ipv4_hex "$ip")"
	output="$(tc filter show dev "$dev" parent "$handle:" protocol ip prio 10 2>/dev/null)" || return 1
	printf '%s\n' "$output" | awk -v flow="flowid $handle:$classid" -v key="match $hex/ffffffff at $offset" '
		/^filter / {
			if (has_flow && has_key) ok=1
			has_flow=0; has_key=0
		}
		index($0, flow) { has_flow=1 }
		index($0, key) { has_key=1 }
		END {
			if (has_flow && has_key) ok=1
			exit !ok
		}'
}

rpc_other_classes_ok() {
	local dev="$1" handle="$2" direction="$3" degraded="$4" forced="$5" tab id mac ip down up normal normal_id=101 slow_id=$((101 + SLOW_OFFSET))
	[ -f "$SHAPER_STATE_DIR/devices" ] && [ ! -L "$SHAPER_STATE_DIR/devices" ] || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip down up; do
		[ -z "$id" ] && continue
		case "$direction" in down) normal="$down" ;; up) normal="$up" ;; *) return 1 ;; esac
		[ -z "$forced" ] || normal="$forced"
		is_uint "$normal" || return 1
		tc_class_value_matches "$dev" "$handle:$normal_id" rate 125 || return 1
		tc_class_value_matches "$dev" "$handle:$normal_id" ceil $((normal * 125)) || return 1
		tc_class_value_matches "$dev" "$handle:$slow_id" rate 125 || return 1
		tc_class_value_matches "$dev" "$handle:$slow_id" ceil $((degraded * 125)) || return 1
		tc qdisc show dev "$dev" | grep -q "qdisc fq_codel $normal_id:" || return 1
		tc qdisc show dev "$dev" | grep -q "qdisc fq_codel $slow_id:" || return 1
		normal_id=$((normal_id + 1))
		slow_id=$((slow_id + 1))
	done < "$SHAPER_STATE_DIR/devices"
}

runtime_shaper_ok() {
	local expected_wan="$1" expected_total_down="$2" expected_total_up="$3" expected_other_down="$4" expected_other_up="$5" expected_degraded="$6" expected_other_count="$7" expected_priority_ips="$8" expected_nft_sha256="$9" expected_wan_tc_sha256="${10}" expected_lan_tc_sha256="${11}"
	local total_down total_up configured_down configured_up effective_down effective_up degraded wan_if lan_if wan_network current_wan rules output_rules account_rules ip id registry tab mac name normal_id slow_id shaper_state forced_down forced_up actual_other_count=0 expected_priority_sorted live_priority_sorted
	config_load bwlimit
	config_get lan_if main lan_if 'br-lan'
	config_get wan_network main wan_network 'provider'
	config_get total_down main total_down_kbit
	config_get total_up main total_up_kbit
	config_get configured_down main other_down_kbit '768'
	config_get configured_up main other_up_kbit '128'
	config_get degraded main other_degraded_kbit '64'
	effective_down="$(cat "$SHAPER_STATE_DIR/other_down_kbit" 2>/dev/null)"
	effective_up="$(cat "$SHAPER_STATE_DIR/other_up_kbit" 2>/dev/null)"
	[ -n "$total_down" ] && [ -n "$total_up" ] && [ -n "$effective_down" ] && [ -n "$effective_up" ] && [ -n "$degraded" ] || return 1
	shaper_state="$(cat "$SHAPER_STATE_DIR/state" 2>/dev/null)"
	case "$shaper_state" in
		active)
			[ "$effective_down" = "$configured_down" ] && [ "$effective_up" = "$configured_up" ] || return 1
			forced_down=''; forced_up=''
			;;
		safe)
			[ "$effective_down" = "$degraded" ] && [ "$effective_up" = "$degraded" ] || return 1
			forced_down="$degraded"; forced_up="$degraded"
			;;
		*) return 1 ;;
	esac
	wan_if="$(cat "$SHAPER_STATE_DIR/wan_if" 2>/dev/null)"
	[ "$expected_wan" = "$wan_if" ] && [ "$expected_total_down" = "$total_down" ] && [ "$expected_total_up" = "$total_up" ] || return 1
	[ "$expected_other_down" = "$effective_down" ] && [ "$expected_other_up" = "$effective_up" ] && [ "$expected_degraded" = "$degraded" ] || return 1
	[ "$expected_priority_ips" = "$(uci -q get bwlimit.main.exempt_ip)" ] || return 1
	[ "$expected_other_count" = "$(cat "$SHAPER_STATE_DIR/other_count" 2>/dev/null)" ] || return 1
	[ "$expected_other_count" = "$(awk -F '\t' 'NF { count++ } END { print count + 0 }' "$SHAPER_STATE_DIR/devices" 2>/dev/null)" ] || return 1
	case "$wan_if:$lan_if:$wan_network" in *[!A-Za-z0-9_.:-]*) return 1 ;; esac
	current_wan="$(ubus call "network.interface.$wan_network" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
	[ "$current_wan" = "$wan_if" ] || return 1
	command -v tc >/dev/null 2>&1 && command -v nft >/dev/null 2>&1 || return 1
	runtime_reservations_ok || return 1
	rpc_shaper_gates_ok "$lan_if" "$wan_if" || return 1
	tc_root_default_ok "$wan_if" "$WAN_HANDLE" || return 1
	tc_class_value_matches "$wan_if" "$WAN_HANDLE:1" ceil $((total_up * 125)) || return 1
	tc_class_value_matches "$wan_if" "$WAN_HANDLE:$OWNER_CLASS" rate 125 || return 1
	tc_class_value_matches "$wan_if" "$WAN_HANDLE:20" rate 125 || return 1
	tc_class_value_matches "$wan_if" "$WAN_HANDLE:20" ceil $((degraded * 125)) || return 1
	! tc class show dev "$wan_if" 2>/dev/null | grep -q "^class htb $WAN_HANDLE:10 " || return 1
	! tc qdisc show dev "$wan_if" 2>/dev/null | grep -q "^qdisc fq_codel 10: parent $WAN_HANDLE:10 " || return 1
	tc qdisc show dev "$wan_if" 2>/dev/null | grep -q 'qdisc fq_codel 20:' || return 1
	tc_root_default_ok "$lan_if" "$LAN_HANDLE" || return 1
	tc_class_value_matches "$lan_if" "$LAN_HANDLE:1" ceil $((total_down * 125)) || return 1
	tc_class_value_matches "$lan_if" "$LAN_HANDLE:$OWNER_CLASS" rate 125 || return 1
	tc_class_value_matches "$lan_if" "$LAN_HANDLE:20" rate 125 || return 1
	tc_class_value_matches "$lan_if" "$LAN_HANDLE:20" ceil $((degraded * 125)) || return 1
	! tc class show dev "$lan_if" 2>/dev/null | grep -q "^class htb $LAN_HANDLE:10 " || return 1
	! tc qdisc show dev "$lan_if" 2>/dev/null | grep -q "^qdisc fq_codel 10: parent $LAN_HANDLE:10 " || return 1
	tc qdisc show dev "$lan_if" 2>/dev/null | grep -q 'qdisc fq_codel 20:' || return 1
	rpc_other_classes_ok "$wan_if" "$WAN_HANDLE" up "$degraded" "$forced_up" || return 1
	rpc_other_classes_ok "$lan_if" "$LAN_HANDLE" down "$degraded" "$forced_down" || return 1
	rules="$(nft list table inet nano_shaper 2>/dev/null)" || return 1
	printf '%s\n' "$rules" | grep -Fq 'comment "nano-monitor-owned-v1"' || return 1
	expected_priority_sorted="$(priority_words_sorted "$expected_priority_ips")" || return 1
	live_priority_sorted="$(nft_priority_words_sorted nano_shaper)" || return 1
	[ -n "$expected_priority_sorted" ] && [ "$live_priority_sorted" = "$expected_priority_sorted" ] || return 1
	printf '%s\n' "$rules" | grep -F "iifname \"$lan_if\" oifname \"$wan_if\"" | grep -Fq "meta priority set $WAN_HANDLE:0 return" || return 1
	printf '%s\n' "$rules" | grep -F "iifname \"$wan_if\" oifname \"$lan_if\"" | grep -Fq "meta priority set $LAN_HANDLE:0 return" || return 1
	output_rules="$(nft list chain inet nano_shaper local_output 2>/dev/null)" || return 1
	printf '%s\n' "$output_rules" | grep -F "oifname \"$wan_if\"" | grep -Fq "meta priority set $WAN_HANDLE:0 return" || return 1
	printf '%s\n' "$output_rules" | grep -F "oifname \"$lan_if\"" | grep -Fq "meta priority set $LAN_HANDLE:0 return" || return 1
	for ip in $(uci -q get bwlimit.main.exempt_ip); do
		printf '%s\n' "$rules" | grep -Fq "$ip" || return 1
	done
	account_rules="$(nft list table inet nano_accounting 2>/dev/null)" || return 1
	printf '%s\n' "$account_rules" | grep -Fq 'comment "nano-monitor-accounting-v1"' || return 1
	[ "$(nft_priority_words_sorted nano_accounting)" = "$expected_priority_sorted" ] || return 1
	registry="$($DEVICE_REGISTRY)" || return 1
	tab="$(printf '\t')"
	normal_id=101
	slow_id=$((101 + SLOW_OFFSET))
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] && continue
		actual_other_count=$((actual_other_count + 1))
		printf '%s\n' "$account_rules" | grep -F "ip saddr $ip" | grep -Fq "meta priority set $WAN_HANDLE:$normal_id" || return 1
		printf '%s\n' "$account_rules" | grep -F "ip saddr $ip" | grep -Fq "meta priority set $WAN_HANDLE:$slow_id" || return 1
		printf '%s\n' "$account_rules" | grep -F "ip daddr $ip" | grep -Fq "meta priority set $LAN_HANDLE:$normal_id" || return 1
		printf '%s\n' "$account_rules" | grep -F "ip daddr $ip" | grep -Fq "meta priority set $LAN_HANDLE:$slow_id" || return 1
		normal_id=$((normal_id + 1))
		slow_id=$((slow_id + 1))
	done <<EOF
$registry
EOF
	[ "$actual_other_count" = "$expected_other_count" ] || return 1
	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = '0' ] || return 1
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = '0' ] || return 1
	effective_flow_offloading_disabled || return 1
	for output_rules in "$expected_nft_sha256" "$expected_wan_tc_sha256" "$expected_lan_tc_sha256"; do
		[ "${#output_rules}" = '64' ] || return 1
		case "$output_rules" in *[!0-9a-f]*) return 1 ;; esac
	done
	[ "$(rpc_nft_topology_fingerprint nano_shaper)" = "$expected_nft_sha256" ] || return 1
	[ "$(rpc_tc_topology_fingerprint "$wan_if")" = "$expected_wan_tc_sha256" ] || return 1
	[ "$(rpc_tc_topology_fingerprint "$lan_if")" = "$expected_lan_tc_sha256" ] || return 1
	rpc_shaper_gates_ok "$lan_if" "$wan_if" || return 1
}

method_shaper() {
	local enabled=0 state message total_down=0 total_up=0 other_down=0 other_up=0 degraded=0 effective_down=0 effective_up=0 other_count=0 wan_if lan_if verified applied owned value data_ok=1 snapshot line priority_ips ip applied_at verification_scope nft_topology_sha256 wan_tc_topology_sha256 lan_tc_topology_sha256 generation_before generation_after generation_live
	config_load bwlimit
	config_get_bool enabled main enabled 0
	config_get lan_if main lan_if 'br-lan'
	generation_before="$(cat "$SHAPER_STATE_DIR/generation" 2>/dev/null)"
	state="$(cat "$SHAPER_STATE_DIR/state" 2>/dev/null)"
	message="$(cat "$SHAPER_STATE_DIR/message" 2>/dev/null)"
	owned="$(cat "$SHAPER_STATE_DIR/owned" 2>/dev/null)"
	[ -f "$SHAPER_STATE_DIR/applied-snapshot" ] && [ ! -L "$SHAPER_STATE_DIR/applied-snapshot" ] || data_ok=0
	snapshot="$(cat "$SHAPER_STATE_DIR/applied-snapshot" 2>/dev/null)" || data_ok=0
	generation_after="$(cat "$SHAPER_STATE_DIR/generation" 2>/dev/null)"
	is_uint "$generation_before" && [ $((generation_before % 2)) -eq 0 ] && [ "$generation_before" = "$generation_after" ] || data_ok=0
	priority_ips=''
	while IFS= read -r line; do
		case "$line" in
			applied_at=*) applied_at="${line#*=}" ;;
			verification_scope=*) verification_scope="${line#*=}" ;;
			wan_if=*) wan_if="${line#*=}" ;;
			total_down_kbit=*) total_down="${line#*=}" ;;
			total_up_kbit=*) total_up="${line#*=}" ;;
			other_down_kbit=*) other_down="${line#*=}"; effective_down="$other_down" ;;
			other_up_kbit=*) other_up="${line#*=}"; effective_up="$other_up" ;;
			degraded_kbit=*) degraded="${line#*=}" ;;
			other_count=*) other_count="${line#*=}" ;;
			nft_topology_sha256=*) nft_topology_sha256="${line#*=}" ;;
			wan_tc_topology_sha256=*) wan_tc_topology_sha256="${line#*=}" ;;
			lan_tc_topology_sha256=*) lan_tc_topology_sha256="${line#*=}" ;;
			priority_ip=*) ip="${line#*=}"; priority_ips="${priority_ips}${priority_ips:+ }$ip" ;;
		esac
	done <<EOF
$snapshot
EOF
	case "$verification_scope:$state" in last_apply:active|safe_fallback:safe) ;; *) data_ok=0 ;; esac
	for value in total_down total_up other_down other_up degraded effective_down effective_up other_count; do
		eval "value=\${$value}"
		is_uint "$value" || data_ok=0
	done
	is_uint "$applied_at" || data_ok=0
	verified='0'
	applied='0'
	if [ "$enabled" = '1' ] && [ "$owned" = 'active' ] && [ "$data_ok" = '1' ] && runtime_shaper_ok "$wan_if" "$total_down" "$total_up" "$other_down" "$other_up" "$degraded" "$other_count" "$priority_ips" "$nft_topology_sha256" "$wan_tc_topology_sha256" "$lan_tc_topology_sha256"; then
		rpc_shaper_gates_ok "$lan_if" "$wan_if" || data_ok=0
		generation_live="$(cat "$SHAPER_STATE_DIR/generation" 2>/dev/null)"
		if [ "$data_ok" = '1' ] && [ "$generation_live" = "$generation_before" ] && is_uint "$generation_live" && [ $((generation_live % 2)) -eq 0 ]; then
			verified='1'
			applied='1'
			[ "$state" = 'active' ] && verification_scope='live_readback'
		else
			message='El estado cambió durante el readback en vivo; vuelve a consultar.'
		fi
	else
		case "$state" in active|safe) message='El último readback verificado del servicio no está disponible.' ;; esac
	fi

	json_init
	json_add_string enabled "$enabled"
	json_add_string state "${state:-unknown}"
	json_add_string message "$message"
	json_add_string verified "$verified"
	json_add_string applied "$applied"
	json_add_string verification_scope "${verification_scope:-unavailable}"
	json_add_string wan_if "$wan_if"
	json_add_string total_down_kbit "$total_down"
	json_add_string total_up_kbit "$total_up"
	json_add_string other_down_kbit "$other_down"
	json_add_string other_up_kbit "$other_up"
	json_add_string other_degraded_kbit "$degraded"
	json_add_string effective_other_down_kbit "${effective_down:-$other_down}"
	json_add_string effective_other_up_kbit "${effective_up:-$other_up}"
	json_add_string other_count "${other_count:-0}"
	json_add_array priority_ips
	for ip in $priority_ips; do json_add_string '' "$ip"; done
	json_close_array
	json_dump
	json_cleanup
}

resolve_registry_device() {
	local wanted="$1" registry tab id mac ip name
	TARGET_ID=''; TARGET_MAC=''; TARGET_IP=''; TARGET_NAME=''
	[ -x "$DEVICE_REGISTRY" ] || return 1
	registry="$($DEVICE_REGISTRY)" || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ "$id" = "$wanted" ] || continue
		[ -z "$TARGET_ID" ] || return 1
		TARGET_ID="$id"; TARGET_MAC="$mac"; TARGET_IP="$ip"; TARGET_NAME="$name"
	done <<EOF
$registry
EOF
	[ "$TARGET_ID" = "$wanted" ]
}

acquire_mutation_lock() {
	local attempt=0
	command -v flock >/dev/null 2>&1 || return 1
	prepare_work_dir || return 1
	[ ! -L "$WORK_DIR/mutation.lock" ] || return 1
	exec 6>"$WORK_DIR/mutation.lock" || return 1
	while ! flock -n 6; do
		[ "$attempt" -lt 10 ] || { exec 6>&-; return 1; }
		attempt=$((attempt + 1))
		sleep 1
	done
}

transition_gates_absent() {
	! nft list table inet nano_release_gate >/dev/null 2>&1 &&
		! nft list table inet nano_accounting_reset_gate >/dev/null 2>&1 &&
		! nft list table inet nano_shaper_gate >/dev/null 2>&1
}

device_section_options_known() {
	local section="$1" output line option
	output="$(uci -q show "bwlimit.$section")" || return 1
	[ -n "$output" ] || return 1
	while IFS= read -r line; do
		case "$line" in
			"bwlimit.$section=device") ;;
			"bwlimit.$section."*=*)
				option="${line#bwlimit.$section.}"
				option="${option%%=*}"
				case "$option" in
					device_id|mac|bonus_day|bonus_bytes|down_kbit|up_kbit) ;;
					*) return 1 ;;
				esac
			;;
			*) return 1 ;;
		esac
	done <<EOF
$output
EOF
}

capture_device_section() {
	local section="$1" type
	OLD_EXISTS=0
	type="$(uci -q get "bwlimit.$section")"
	[ -n "$type" ] || return 0
	[ "$type" = 'device' ] || return 1
	device_section_options_known "$section" || return 1
	OLD_EXISTS=1
	OLD_DEVICE_ID="$(uci -q get "bwlimit.$section.device_id")"
	OLD_MAC="$(uci -q get "bwlimit.$section.mac")"
	[ "$OLD_DEVICE_ID" = "$TARGET_ID" ] && [ "$OLD_MAC" = "$TARGET_MAC" ] || return 1
	OLD_BONUS_DAY="$(uci -q get "bwlimit.$section.bonus_day")"
	OLD_BONUS_BYTES="$(uci -q get "bwlimit.$section.bonus_bytes")"
	OLD_DOWN="$(uci -q get "bwlimit.$section.down_kbit")"
	OLD_UP="$(uci -q get "bwlimit.$section.up_kbit")"
	return 0
}

restore_device_section() {
	local section="$1"
	uci -q delete "bwlimit.$section" 2>/dev/null || :
	if [ "$OLD_EXISTS" = '1' ]; then
		uci -q set "bwlimit.$section=device" || return 1
		uci -q set "bwlimit.$section.device_id=$OLD_DEVICE_ID" || return 1
		uci -q set "bwlimit.$section.mac=$OLD_MAC" || return 1
		[ -z "$OLD_BONUS_DAY" ] || uci -q set "bwlimit.$section.bonus_day=$OLD_BONUS_DAY" || return 1
		[ -z "$OLD_BONUS_BYTES" ] || uci -q set "bwlimit.$section.bonus_bytes=$OLD_BONUS_BYTES" || return 1
		[ -z "$OLD_DOWN" ] || uci -q set "bwlimit.$section.down_kbit=$OLD_DOWN" || return 1
		[ -z "$OLD_UP" ] || uci -q set "bwlimit.$section.up_kbit=$OLD_UP" || return 1
	fi
	uci -q commit bwlimit
}

write_device_policy() {
	local section="$1" day="$2" bonus="$3" down="$4" up="$5" base_down="$6" base_up="$7"
	uci -q delete "bwlimit.$section" 2>/dev/null || :
	if [ "$bonus" = '0' ] && [ "$down" = "$base_down" ] && [ "$up" = "$base_up" ]; then
		uci -q commit bwlimit
		return
	fi
	uci -q set "bwlimit.$section=device" || return 1
	uci -q set "bwlimit.$section.device_id=$TARGET_ID" || return 1
	uci -q set "bwlimit.$section.mac=$TARGET_MAC" || return 1
	if [ "$bonus" != '0' ]; then
		uci -q set "bwlimit.$section.bonus_day=$day" || return 1
		uci -q set "bwlimit.$section.bonus_bytes=$bonus" || return 1
	fi
	[ "$down" = "$base_down" ] || uci -q set "bwlimit.$section.down_kbit=$down" || return 1
	[ "$up" = "$base_up" ] || uci -q set "bwlimit.$section.up_kbit=$up" || return 1
	uci -q commit bwlimit
}

runtime_device_policy_ok() {
	local id="$1" expected_limit="$2" expected_bonus="$3" expected_down="$4" expected_up="$5"
	local period_day base_quota base_down base_up total_down total_up degraded actual tab marker sid smac sip sname sused slimit sbonus sdown sup
	local devices did dmac dip ddown dup classid=101 target_classid='' found=0 wan_if lan_if generation_before generation_after
	config_load bwlimit
	config_get base_quota main quota_per_device_bytes '700000000'
	config_get base_down main other_down_kbit '768'
	config_get base_up main other_up_kbit '128'
	config_get total_down main total_down_kbit '8800'
	config_get total_up main total_up_kbit '4200'
	config_get degraded main other_degraded_kbit '64'
	period_day="$(sed -n 's/^day=//p' "$ACCOUNT_SNAPSHOT" 2>/dev/null | sed -n '1p')"
	case "$period_day" in ????-??-??) ;; *) return 1 ;; esac
	resolve_registry_device "$id" || return 1
	load_device_policy "$id" "$TARGET_MAC" "$period_day" "$base_quota" "$base_down" "$base_up" "$total_down" "$total_up" "$degraded" || return 1
	[ "$POLICY_LIMIT_BYTES" = "$expected_limit" ] && [ "$POLICY_BONUS_BYTES" = "$expected_bonus" ] && [ "$POLICY_DOWN_KBIT" = "$expected_down" ] && [ "$POLICY_UP_KBIT" = "$expected_up" ] || return 1
	actual="$(nft_quota_bytes "$id")" || return 1
	[ "$actual" = "$expected_limit" ] || return 1
	[ "$(cat "$ACCOUNT_STATE_DIR/state" 2>/dev/null)" = 'active' ] || return 1
	tab="$(printf '\t')"
	marker="$(awk -F '\t' -v wanted="$id" '$1 == "device" && $2 == wanted { print; exit }' "$ACCOUNT_SNAPSHOT" 2>/dev/null)"
	[ -n "$marker" ] || return 1
	IFS="$tab" read -r marker sid smac sip sname sused slimit sbonus sdown sup <<EOF
$marker
EOF
	[ "$sid" = "$id" ] && [ "$smac" = "$TARGET_MAC" ] && [ "$slimit" = "$expected_limit" ] && [ "$sbonus" = "$expected_bonus" ] && [ "$sdown" = "$expected_down" ] && [ "$sup" = "$expected_up" ] || return 1
	generation_before="$(cat "$SHAPER_STATE_DIR/generation" 2>/dev/null)"
	is_uint "$generation_before" && [ $((generation_before % 2)) -eq 0 ] || return 1
	[ "$(cat "$SHAPER_STATE_DIR/state" 2>/dev/null)" = 'active' ] && [ "$(cat "$SHAPER_STATE_DIR/owned" 2>/dev/null)" = 'active' ] || return 1
	[ -f "$SHAPER_STATE_DIR/devices" ] && [ ! -L "$SHAPER_STATE_DIR/devices" ] || return 1
	devices="$(cat "$SHAPER_STATE_DIR/devices" 2>/dev/null)" || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r did dmac dip ddown dup; do
		[ -z "$did" ] && continue
		if [ "$did" = "$id" ]; then
			found=$((found + 1))
			target_classid="$classid"
			[ "$dmac" = "$TARGET_MAC" ] && [ "$ddown" = "$expected_down" ] && [ "$dup" = "$expected_up" ] || return 1
		fi
		classid=$((classid + 1))
	done <<EOF
$devices
EOF
	[ "$found" = '1' ] || return 1
	wan_if="$(cat "$SHAPER_STATE_DIR/wan_if" 2>/dev/null)"
	lan_if="$(cat "$SHAPER_STATE_DIR/lan_if" 2>/dev/null)"
	tc_class_value_matches "$wan_if" "$WAN_HANDLE:$target_classid" ceil $((expected_up * 125)) || return 1
	tc_class_value_matches "$lan_if" "$LAN_HANDLE:$target_classid" ceil $((expected_down * 125)) || return 1
	generation_after="$(cat "$SHAPER_STATE_DIR/generation" 2>/dev/null)"
	[ "$generation_before" = "$generation_after" ] && [ "$(cat "$SHAPER_STATE_DIR/state" 2>/dev/null)" = 'active' ]
}

wait_device_policy() {
	local attempt=0
	while [ "$attempt" -lt 15 ]; do
		runtime_device_policy_ok "$@" && return 0
		attempt=$((attempt + 1))
		[ "$attempt" -ge 15 ] || sleep 1
	done
	return 1
}

reconcile_device_policy() {
	local attempt=0
	while [ "$attempt" -lt 2 ]; do
		if "$RECONCILE" reconcile 6>&- >/dev/null 2>&1 && wait_device_policy "$@"; then
			return 0
		fi
		attempt=$((attempt + 1))
	done
	return 1
}

method_set_device_policy() {
	local input keys key requested_id requested_bonus requested_down requested_up section period_day
	local base_quota base_down base_up total_down total_up degraded bonus_bytes expected_limit old_limit old_bonus old_down old_up migration_hold generation_before generation_after
	input="$(cat)"
	json_load "$input" 2>/dev/null || { json_error 'Solicitud JSON no válida.'; return 1; }
	json_get_keys keys
	for key in $keys; do
		case "$key" in ubus_rpc_session|device_id|bonus_mb|down_kbit|up_kbit) ;; *)
			json_error "Argumento no permitido: $key"; json_cleanup; return 1
		;; esac
	done
	json_get_var requested_id device_id
	json_get_var requested_bonus bonus_mb
	json_get_var requested_down down_kbit
	json_get_var requested_up up_kbit
	json_cleanup
	policy_valid_id "$requested_id" || { json_error 'La identidad del dispositivo no es válida.'; return 1; }
	for value in "$requested_bonus" "$requested_down" "$requested_up"; do
		is_uint "$value" || { json_error 'MB y velocidades deben ser números enteros.'; return 1; }
	done
	transition_gates_absent || { json_error 'Hay una transición de red en curso; no se modificó la política.'; return 1; }
	acquire_mutation_lock || { json_error 'No se pudo bloquear la configuración.'; return 1; }
	transition_gates_absent || { json_error 'Hay una transición de red en curso; no se modificó la política.'; return 1; }
	if [ -e "$MIGRATION_FILE" ] || [ -L "$MIGRATION_FILE" ]; then
		json_error 'La migración preventiva debe completar su reset diario antes de ajustar un dispositivo.'
		return 1
	fi
	generation_before="$(cat "$ACCOUNT_STATE_DIR/generation" 2>/dev/null)"
	migration_hold="$(sed -n 's/^migration_hold=//p' "$ACCOUNT_SNAPSHOT" 2>/dev/null | sed -n '1p')"
	generation_after="$(cat "$ACCOUNT_STATE_DIR/generation" 2>/dev/null)"
	if ! is_uint "$generation_before" || [ $((generation_before % 2)) -ne 0 ] || [ "$generation_before" != "$generation_after" ] || [ "$(cat "$ACCOUNT_STATE_DIR/state" 2>/dev/null)" != 'active' ] || [ "$migration_hold" != '0' ]; then
		json_error 'La contabilidad individual aún no publicó un periodo estable sin migración preventiva.'
		return 1
	fi
	config_load bwlimit
	config_get base_quota main quota_per_device_bytes '700000000'
	config_get base_down main other_down_kbit '768'
	config_get base_up main other_up_kbit '128'
	config_get total_down main total_down_kbit '8800'
	config_get total_up main total_up_kbit '4200'
	config_get degraded main other_degraded_kbit '64'
	[ "$requested_bonus" -le 1000000 ] || { json_error 'La compensación no puede superar 1.000.000 MB.'; return 1; }
	[ "$requested_down" -ge "$degraded" ] && [ "$requested_down" -le "$total_down" ] || { json_error "La descarga debe estar entre $degraded y $total_down Kbit/s."; return 1; }
	[ "$requested_up" -ge "$degraded" ] && [ "$requested_up" -le "$total_up" ] || { json_error "La subida debe estar entre $degraded y $total_up Kbit/s."; return 1; }
	bonus_bytes="$(uint_mul "$requested_bonus" 1000000)"
	expected_limit="$(awk -v q="$base_quota" -v b="$bonus_bytes" 'BEGIN { printf "%.0f", q+b }')"
	uint_ge 1000000000000 "$expected_limit" || { json_error 'La cuota efectiva supera el máximo seguro.'; return 1; }
	resolve_registry_device "$requested_id" || { json_error 'El dispositivo ya no pertenece a Otros.'; return 1; }
	period_day="$(sed -n 's/^day=//p' "$ACCOUNT_SNAPSHOT" 2>/dev/null | sed -n '1p')"
	case "$period_day" in ????-??-??) ;; *) json_error 'El periodo diario no está verificado.'; return 1 ;; esac
	section="$(policy_section_for "$requested_id")" || { json_error 'No se pudo resolver la sección individual.'; return 1; }
	capture_device_section "$section" || { json_error 'La configuración individual existente no conserva su identidad.'; return 1; }
	load_device_policy "$requested_id" "$TARGET_MAC" "$period_day" "$base_quota" "$base_down" "$base_up" "$total_down" "$total_up" "$degraded" || { json_error 'La configuración individual anterior no es válida.'; return 1; }
	old_limit="$POLICY_LIMIT_BYTES"; old_bonus="$POLICY_BONUS_BYTES"; old_down="$POLICY_DOWN_KBIT"; old_up="$POLICY_UP_KBIT"
	if ! write_device_policy "$section" "$period_day" "$bonus_bytes" "$requested_down" "$requested_up" "$base_down" "$base_up"; then
		restore_device_section "$section" >/dev/null 2>&1
		json_error 'No se pudo guardar el ajuste individual.'
		return 1
	fi
	if ! reconcile_device_policy "$requested_id" "$expected_limit" "$bonus_bytes" "$requested_down" "$requested_up"; then
		if restore_device_section "$section" && reconcile_device_policy "$requested_id" "$old_limit" "$old_bonus" "$old_down" "$old_up"; then
			json_error 'No se pudo verificar el ajuste; se restauraron y verificaron los valores anteriores.'
		else
			json_error 'No se pudo verificar el ajuste ni su restauración; revise contabilidad y shaping.'
		fi
		return 1
	fi
	method_accounting
}

method_set_quota() {
	local input keys key requested old
	input="$(cat)"
	json_load "$input" 2>/dev/null || {
		json_error 'Solicitud JSON no válida.'
		return 1
	}
	json_get_keys keys
	for key in $keys; do
		case "$key" in ubus_rpc_session|quota_mb) ;; *)
			json_error "Argumento no permitido: $key"
			json_cleanup
			return 1
		;; esac
	done
	json_get_var requested quota_mb
	json_cleanup
	case "$requested" in ''|*[!0-9]*)
		json_error 'La cuota debe ser un número entero de MB.'
		return 1
	;; esac
	if [ "$requested" -lt 100 ] || [ "$requested" -gt 1000000 ]; then
		json_error 'La cuota debe estar entre 100 MB y 1.000.000 MB.'
		return 1
	fi
	requested="$(uint_mul "$requested" 1000000)"
	transition_gates_absent || { json_error 'Hay una transición de red en curso; no se modificó la cuota.'; return 1; }
	acquire_mutation_lock || { json_error 'No se pudo bloquear la configuración.'; return 1; }
	transition_gates_absent || { json_error 'Hay una transición de red en curso; no se modificó la cuota.'; return 1; }
	old="$(uci -q get bwlimit.main.quota_per_device_bytes)"
	is_uint "$old" || old='700000000'
	if ! uci -q set bwlimit.main.quota_per_device_bytes="$requested" ||
		! uci -q commit bwlimit ||
		[ "$(uci -q get bwlimit.main.quota_per_device_bytes)" != "$requested" ]; then
		if restore_quota_value "$old"; then
			json_error 'No se pudo guardar la cuota; se verificó la restauración del valor anterior.'
		else
			json_error 'No se pudo guardar la cuota ni verificar su restauración; revise la contabilidad.'
		fi
		return 1
	fi
	if ! reconcile_accounting_quota "$requested"; then
		if restore_quota_value "$old"; then
			json_error 'No se pudo verificar la cuota; se verificó la restauración del valor anterior.'
		else
			json_error 'No se pudo verificar la cuota ni su restauración; revise el estado de contabilidad.'
		fi
		return 1
	fi
	method_accounting
}

case "$1" in
	list)
		json_init
		json_add_object status
		json_close_object
		json_add_object start
		json_close_object
		json_add_object accounting
		json_close_object
		json_add_object shaper
		json_close_object
		json_add_object set_quota
		json_add_string quota_mb 'Integer'
		json_close_object
		json_add_object set_device_policy
		json_add_string device_id 'String'
		json_add_string bonus_mb 'Integer'
		json_add_string down_kbit 'Integer'
		json_add_string up_kbit 'Integer'
		json_close_object
		json_dump
		json_cleanup
		;;
	call)
		case "$2" in
			status|start|accounting|shaper)
				validate_input || exit 1
				"method_$2"
				;;
			set_quota)
				method_set_quota
				;;
			set_device_policy)
				method_set_device_policy
				;;
			*)
				json_error 'Método no permitido.'
				exit 1
				;;
		esac
		;;
	*)
		json_error 'Operación RPC no permitida.'
		exit 1
		;;
esac
