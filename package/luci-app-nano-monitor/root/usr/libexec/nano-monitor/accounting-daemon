. /lib/functions.sh

TABLE_FAMILY='inet'
TABLE_NAME='nano_accounting'
RUN_DIR='/var/run/nano-accounting'
STATE_DIR='/etc/nano-monitor'
STATE_FILE="$STATE_DIR/daily-state"
DEVICE_STATE_DIR="$STATE_DIR/daily-devices"
MIGRATION_FILE="$STATE_DIR/v4-migration"
DIRTY_FILE="$STATE_DIR/accounting-dirty"
BOOT_FILE="$STATE_DIR/accounting-boot-id"
HANDOFF_FILE="$RUN_DIR/handoff"
DEVICES_FILE="$RUN_DIR/devices"
CURRENT_FILE="$RUN_DIR/current-devices"
LIVE_SEEDS_FILE="$RUN_DIR/live-seeds"
TABLE_IDS_FILE="$RUN_DIR/table-ids"
REGISTRY='/usr/libexec/nano-monitor/device-registry'
TZ='EST5EDT,M3.2.0,M11.1.0'
OWNER_COMMENT='nano-monitor-accounting-v1'
WAN_HANDLE=1001
LAN_HANDLE=1002
SLOW_OFFSET=1000
MAX_DEVICES=900
POLL_INTERVAL=10
BOOT_GUARD_SECONDS=60
export TZ

is_uint() {
	case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

uint_ge() {
	awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'
}

valid_iface() {
	case "$1" in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; *) return 0 ;; esac
}

valid_id() {
	case "$1" in
		????????????) case "$1" in *[!0-9a-f]*) return 1 ;; *) return 0 ;; esac ;;
		*) return 1 ;;
	esac
}

write_runtime() {
	local state="$1" message="$2"
	mkdir -p "$RUN_DIR"
	printf '%s\n' "$state" > "$RUN_DIR/state.tmp"
	printf '%s\n' "$message" > "$RUN_DIR/message.tmp"
	mv "$RUN_DIR/state.tmp" "$RUN_DIR/state"
	mv "$RUN_DIR/message.tmp" "$RUN_DIR/message"
}

add_priority_ip() {
	case "$1" in ''|*[!0-9.]*) return ;; esac
	PRIORITY_SET="${PRIORITY_SET}${PRIORITY_SET:+, }$1"
}

build_devices_file() {
	local tmp="$DEVICES_FILE.tmp" tab id mac ip name count=0
	[ -x "$REGISTRY" ] || return 1
	"$REGISTRY" > "$tmp" || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] && continue
		valid_id "$id" || { rm -f "$tmp"; return 1; }
		case "$ip" in ''|*[!0-9.]*) rm -f "$tmp"; return 1 ;; esac
		count=$((count + 1))
	done < "$tmp"
	[ "$count" -le "$MAX_DEVICES" ] || { rm -f "$tmp"; return 1; }
	mv "$tmp" "$DEVICES_FILE"
}

load_settings() {
	local status value
	config_load bwlimit
	config_get_bool quota_enabled main quota_enabled 1
	[ "$quota_enabled" = '1' ] || return 1
	config_get quota_bytes main quota_per_device_bytes '700000000'
	config_get lan_if main lan_if 'br-lan'
	config_get wan_network main wan_network 'provider'
	config_get subnet main subnet '192.168.1.0/24'
	config_get persist_interval main quota_persist_interval '1800'
	config_get persist_step main quota_persist_step_bytes '64000000'
	config_get reset_hour main quota_reset_hour '0'
	config_get reset_minute main quota_reset_minute '1'
	config_get total_down_kbit main total_down_kbit '8800'
	config_get total_up_kbit main total_up_kbit '4200'
	[ "$(uci -q get system.@system[0].zonename)" = 'America/New_York' ] || return 1
	[ "$(uci -q get system.@system[0].timezone)" = "$TZ" ] || return 1
	PRIORITY_SET=''
	config_list_foreach main exempt_ip add_priority_ip
	[ -n "$PRIORITY_SET" ] || return 1
	for value in "$quota_bytes" "$persist_interval" "$persist_step" "$reset_hour" "$reset_minute" "$total_down_kbit" "$total_up_kbit"; do
		is_uint "$value" || return 1
	done
	uint_ge "$quota_bytes" 100000000 || return 1
	uint_ge 1000000000000 "$quota_bytes" || return 1
	[ "$persist_interval" -ge 60 ] && [ "$persist_step" -ge 1000000 ] || return 1
	[ "$reset_hour" -le 23 ] && [ "$reset_minute" -le 59 ] || return 1
	# Covers a complete early-boot/network convergence window at the aggregate
	# ceiling. persist_step adds a second durable margin between writes.
	recovery_guard_bytes="$(awk -v d="$total_down_kbit" -v u="$total_up_kbit" -v s="$BOOT_GUARD_SECONDS" 'BEGIN { printf "%.0f", (d+u)*1000*s/8 }')"
	is_uint "$recovery_guard_bytes" || return 1
	reset_at_minute=$((reset_hour * 60 + reset_minute))
	valid_iface "$lan_if" && [ -d "/sys/class/net/$lan_if" ] || return 1
	case "$subnet" in ''|*[!0-9./]*) return 1 ;; esac
	status="$(ubus call "network.interface.$wan_network" status 2>/dev/null)"
	wan_if="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)"
	valid_iface "$wan_if" && [ -d "/sys/class/net/$wan_if" ] || return 1
	build_devices_file
}

state_value() {
	local key="$1"
	sed -n "s/^${key}=//p" "$STATE_FILE" 2>/dev/null | sed -n '1p'
}

load_saved_counters() {
	local value name invalid=0
	if [ ! -e "$STATE_FILE" ]; then
		period_day=''
		for name in internet_up internet_down priority_up priority_down others_up others_down; do eval "$name=0"; done
		return 0
	fi
	[ -f "$STATE_FILE" ] && [ ! -L "$STATE_FILE" ] || invalid=1
	period_day="$(state_value day)"
	case "$period_day" in ????-??-??) ;; *) invalid=1 ;; esac
	for name in internet_up internet_down priority_up priority_down others_up others_down; do
		value="$(state_value "$name")"
		is_uint "$value" || { value=0; invalid=1; }
		eval "$name=\$value"
	done
	if [ "$invalid" != '0' ]; then
		period_day="$(date +%F)"
		for name in internet_up internet_down priority_up priority_down others_up others_down; do eval "$name=0"; done
		force_degraded=1
	fi
}

device_saved_used() {
	local id="$1" file="$DEVICE_STATE_DIR/$1" day used reserved live authority=0 saved_valid=0
	if [ "$force_degraded" = '1' ]; then
		printf '%s' "$quota_bytes"
		return
	elif [ "$migration_active" = '1' ]; then
		used="$migration_seed"
	elif [ "$deliberate_daily_reset" = '1' ]; then
		printf '0'
		return
	elif [ ! -e "$file" ]; then
		[ "$unclean_start" = '1' ] && used="$quota_bytes" || used=0
	elif ! [ -f "$file" ] || [ -L "$file" ]; then
		used="$quota_bytes"
	else
		day="$(sed -n 's/^day=//p' "$file" | sed -n '1p')"
		used="$(sed -n 's/^used=//p' "$file" | sed -n '1p')"
		if [ "$day" != "$period_day" ] || ! is_uint "$used"; then
			used="$quota_bytes"
		else
			saved_valid=1
		fi
	fi
	# A surviving signed table is the freshest authority. This closes both a
	# graceful handoff and an arbitrarily long dirty session without guessing a
	# traffic guard. A deliberate daily reset disables this carry-over.
	if [ "$deliberate_daily_reset" = '0' ]; then
		if [ "$live_table_present" = '1' ]; then
			live="$(quota_used_for "$id" 2>/dev/null)"
		elif [ -f "$LIVE_SEEDS_FILE" ] && [ ! -L "$LIVE_SEEDS_FILE" ]; then
			live="$(awk -v wanted="$id" '$1 == wanted { print $2; exit }' "$LIVE_SEEDS_FILE")"
		fi
		if is_uint "$live"; then
			authority=1
			if uint_ge "$live" "$used"; then used="$live"; fi
		fi
		# Reserve only when no live/snapshotted authority survived and either the
		# prior session was dirty or this is a new router boot. Same-boot clean
		# stop/start cycles retain used without artificial consumption.
		if [ "$saved_valid" = '1' ] && [ "$authority" = '0' ] && { [ "$unclean_start" = '1' ] || [ "$boot_changed" = '1' ]; }; then
			reserved="$(sed -n 's/^reserved=//p' "$file" | sed -n '1p')"
			is_uint "$reserved" && used="$reserved" || used="$quota_bytes"
		fi
	fi
	printf '%s' "$used"
}

inspect_previous_session() {
	unclean_start=0
	if [ -e "$DIRTY_FILE" ]; then
		[ -f "$DIRTY_FILE" ] && [ ! -L "$DIRTY_FILE" ] || return 1
		unclean_start=1
	fi
}

inspect_boot() {
	local saved
	current_boot_id="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
	case "$current_boot_id" in ''|*[!0-9a-f-]*) return 1 ;; esac
	boot_changed=1
	if [ -f "$BOOT_FILE" ] && [ ! -L "$BOOT_FILE" ]; then
		saved="$(sed -n '1p' "$BOOT_FILE")"
		[ "$saved" = "$current_boot_id" ] && boot_changed=0
	fi
	# A changed boot ID is expected after a reboot, not an inspection failure.
	return 0
}

inspect_existing_table() {
	live_table_present=0
	if nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1; then
		accounting_table_owned || return 1
		live_table_present=1
	fi
}

mark_runtime_dirty() {
	mkdir -p -m 0700 "$STATE_DIR" || return 1
	[ ! -L "$STATE_DIR" ] && [ ! -L "$DIRTY_FILE" ] || return 1
	umask 077
	printf 'pid=%s\n' "$$" > "$DIRTY_FILE.tmp" && mv "$DIRTY_FILE.tmp" "$DIRTY_FILE" && sync
}

mark_runtime_clean() {
	rm -f "$DIRTY_FILE" && sync
}

persist_boot_id() {
	[ ! -L "$BOOT_FILE" ] || return 1
	printf '%s\n' "$current_boot_id" > "$BOOT_FILE.tmp" && mv "$BOOT_FILE.tmp" "$BOOT_FILE" && sync
}

load_migration_seed() {
	local day used
	migration_active=0; migration_seed=0
	[ -e "$MIGRATION_FILE" ] || return 0
	[ -f "$MIGRATION_FILE" ] && [ ! -L "$MIGRATION_FILE" ] || { migration_active=1; migration_seed="$quota_bytes"; return; }
	day="$(sed -n 's/^day=//p' "$MIGRATION_FILE" | sed -n '1p')"
	used="$(sed -n 's/^used=//p' "$MIGRATION_FILE" | sed -n '1p')"
	migration_active=1
	if [ "$day" = "$period_day" ] && is_uint "$used" && uint_ge "$quota_bytes" "$used"; then migration_seed="$used"; else migration_seed="$quota_bytes"; fi
}

counter_bytes() {
	local name="$1" value
	value="$(nft -j list counter "$TABLE_FAMILY" "$TABLE_NAME" "$name" 2>/dev/null | jsonfilter -e '@.nftables[*].counter.bytes' 2>/dev/null)"
	is_uint "$value" || return 1
	printf '%s' "$value"
}

merge_live_counters() {
	local name live durable
	[ "$live_table_present" = '1' ] && [ "$deliberate_daily_reset" = '0' ] || return 0
	for name in internet_up internet_down priority_up priority_down others_up others_down; do
		live="$(counter_bytes "$name" 2>/dev/null)" || return 1
		eval "durable=\${$name}"
		if uint_ge "$live" "$durable"; then eval "$name=\$live"; fi
	done
}

snapshot_live_quotas() {
	local id used tmp="$LIVE_SEEDS_FILE.tmp" ids="$TABLE_IDS_FILE" strict=1
	[ "$live_table_present" = '1' ] || { rm -f "$LIVE_SEEDS_FILE"; return 0; }
	if [ ! -f "$ids" ] || [ -L "$ids" ]; then
		# Upgrade compatibility: recover every quota still present, while allowing
		# IDs newly introduced by the current registry to start from durable/zero.
		ids="$DEVICES_FILE"
		strict=0
	fi
	: > "$tmp" || return 1
	while read -r id rest; do
		[ -z "$id" ] && continue
		valid_id "$id" || { rm -f "$tmp"; return 1; }
		if [ "$strict" = '1' ] && ! awk -v wanted="$id" '$1 == wanted { found=1; exit } END { exit !found }' "$DEVICES_FILE"; then
			# The previous table may legitimately include a lease removed from the
			# registry used to build its successor.
			continue
		fi
		used="$(quota_used_for "$id" 2>/dev/null)" || {
			[ "$strict" = '0' ] && continue
			rm -f "$tmp"; return 1
		}
		printf '%s\t%s\n' "$id" "$used" >> "$tmp" || { rm -f "$tmp"; return 1; }
	done < "$ids"
	mv "$tmp" "$LIVE_SEEDS_FILE"
}

persist_table_ids() {
	local tab id mac ip name tmp="$TABLE_IDS_FILE.tmp"
	[ ! -L "$TABLE_IDS_FILE" ] || return 1
	: > "$tmp" || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] && continue
		valid_id "$id" || { rm -f "$tmp"; return 1; }
		printf '%s\n' "$id" >> "$tmp" || { rm -f "$tmp"; return 1; }
	done < "$DEVICES_FILE"
	mv "$tmp" "$TABLE_IDS_FILE"
}

quota_used_for() {
	local id="$1" value
	valid_id "$id" || return 1
	value="$(nft -j list quota "$TABLE_FAMILY" "$TABLE_NAME" "q_$id" 2>/dev/null | jsonfilter -e '@.nftables[*].quota.used' 2>/dev/null)"
	is_uint "$value" || return 1
	printf '%s' "$value"
}

read_counters() {
	local tab id mac ip name used tmp="$CURRENT_FILE.tmp"
	internet_up="$(counter_bytes internet_up)" || return 1
	internet_down="$(counter_bytes internet_down)" || return 1
	priority_up="$(counter_bytes priority_up)" || return 1
	priority_down="$(counter_bytes priority_down)" || return 1
	others_up="$(counter_bytes others_up)" || return 1
	others_down="$(counter_bytes others_down)" || return 1
	: > "$tmp" || return 1
	device_total_used=0
	degraded_count=0
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] && continue
		used="$(quota_used_for "$id")" || { rm -f "$tmp"; return 1; }
		printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$mac" "$ip" "$name" "$used" >> "$tmp" || return 1
		device_total_used="$(awk -v a="$device_total_used" -v b="$used" 'BEGIN { printf "%.0f", a + b }')"
		uint_ge "$used" "$quota_bytes" && degraded_count=$((degraded_count + 1))
	done < "$DEVICES_FILE"
	mv "$tmp" "$CURRENT_FILE"
}

zero_current_devices() {
	local tab id mac ip name
	: > "$CURRENT_FILE.tmp" || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] && continue
		printf '%s\t%s\t%s\t%s\t0\n' "$id" "$mac" "$ip" "$name" >> "$CURRENT_FILE.tmp" || return 1
	done < "$DEVICES_FILE"
	mv "$CURRENT_FILE.tmp" "$CURRENT_FILE"
	device_total_used=0
	degraded_count=0
}

persist_values() {
	local tmp="$STATE_FILE.tmp" key expected saved tab id mac ip name used reserved file
	mkdir -p -m 0700 "$STATE_DIR" "$DEVICE_STATE_DIR" || return 1
	[ ! -L "$STATE_DIR" ] && [ ! -L "$DEVICE_STATE_DIR" ] || return 1
	umask 077
	{
		printf 'day=%s\n' "$period_day"
		printf 'internet_up=%s\n' "$internet_up"
		printf 'internet_down=%s\n' "$internet_down"
		printf 'priority_up=%s\n' "$priority_up"
		printf 'priority_down=%s\n' "$priority_down"
		printf 'others_up=%s\n' "$others_up"
		printf 'others_down=%s\n' "$others_down"
	} > "$tmp" && mv "$tmp" "$STATE_FILE" || return 1
	for key in day internet_up internet_down priority_up priority_down others_up others_down; do
		[ "$key" = 'day' ] && expected="$period_day" || eval "expected=\${$key}"
		saved="$(state_value "$key")"
		[ "$saved" = "$expected" ] || return 1
	done
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name used; do
		[ -z "$id" ] && continue
		valid_id "$id" && is_uint "$used" || return 1
		file="$DEVICE_STATE_DIR/$id"
		[ ! -L "$file" ] || return 1
		reserved="$(awk -v u="$used" -v s="$persist_step" -v g="$recovery_guard_bytes" -v q="$quota_bytes" 'BEGIN { n=u+s+g; if (n>q) n=q; printf "%.0f", n }')"
		{
			printf 'day=%s\n' "$period_day"
			printf 'mac=%s\n' "$mac"
			printf 'used=%s\n' "$used"
			printf 'reserved=%s\n' "$reserved"
		} > "$file.tmp" && mv "$file.tmp" "$file" || return 1
		[ "$(sed -n 's/^used=//p' "$file" | sed -n '1p')" = "$used" ] || return 1
		[ "$(sed -n 's/^reserved=//p' "$file" | sed -n '1p')" = "$reserved" ] || return 1
	done < "$CURRENT_FILE"
	sync || return 1
	last_persist_epoch="$(date +%s)"
	last_persist_total="$device_total_used"
}

persist_state() {
	read_counters || return 1
	persist_values
}

ensure_offloading_disabled() {
	local changed=0 rules
	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = '0' ] || { uci -q set firewall.@defaults[0].flow_offloading='0' || return 1; changed=1; }
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = '0' ] || { uci -q set firewall.@defaults[0].flow_offloading_hw='0' || return 1; changed=1; }
	[ "$changed" = '0' ] || { uci -q commit firewall || return 1; }
	rules="$(nft list ruleset 2>/dev/null)" || return 1
	if [ "$changed" != '0' ] || printf '%s\n' "$rules" | grep -Eq '(^|[[:space:]])flowtable[[:space:]]|flow add @'; then
		/etc/init.d/firewall restart >/dev/null 2>&1 || return 1
		rules="$(nft list ruleset 2>/dev/null)" || return 1
	fi
	! printf '%s\n' "$rules" | grep -Eq '(^|[[:space:]])flowtable[[:space:]]|flow add @'
}

install_table() {
	local replace='' tab id mac ip name used classid=101 slowid
	if nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1; then
		accounting_table_owned || return 1
		replace="delete table $TABLE_FAMILY $TABLE_NAME"
	fi
	{
		[ -z "$replace" ] || printf '%s\n' "$replace"
		printf 'table %s %s {\n' "$TABLE_FAMILY" "$TABLE_NAME"
		printf '\tcomment "%s"\n' "$OWNER_COMMENT"
		printf '\tset priority_v4 { type ipv4_addr; elements = { %s }; }\n' "$PRIORITY_SET"
		printf '\tcounter internet_up { packets 0 bytes %s; }\n' "$internet_up"
		printf '\tcounter internet_down { packets 0 bytes %s; }\n' "$internet_down"
		printf '\tcounter priority_up { packets 0 bytes %s; }\n' "$priority_up"
		printf '\tcounter priority_down { packets 0 bytes %s; }\n' "$priority_down"
		printf '\tcounter others_up { packets 0 bytes %s; }\n' "$others_up"
		printf '\tcounter others_down { packets 0 bytes %s; }\n' "$others_down"
		tab="$(printf '\t')"
		while IFS="$tab" read -r id mac ip name; do
			[ -z "$id" ] && continue
			used="$(device_saved_used "$id")"
			printf '\tquota q_%s { %s bytes used %s bytes; }\n' "$id" "$quota_bytes" "$used"
		done < "$DEVICES_FILE"
		printf '\tchain account {\n'
		printf '\t\ttype filter hook forward priority -6; policy accept;\n'
		printf '\t\tiifname "%s" oifname "%s" ip saddr @priority_v4 counter name internet_up counter name priority_up return\n' "$lan_if" "$wan_if"
		printf '\t\tiifname "%s" oifname "%s" ip saddr %s ip saddr != @priority_v4 counter name internet_up counter name others_up\n' "$lan_if" "$wan_if" "$subnet"
		classid=101
		while IFS="$tab" read -r id mac ip name; do
			[ -z "$id" ] && continue
			slowid=$((classid + SLOW_OFFSET))
			printf '\t\tiifname "%s" oifname "%s" ip saddr %s quota name q_%s meta priority set %s:%s return\n' "$lan_if" "$wan_if" "$ip" "$id" "$WAN_HANDLE" "$classid"
			printf '\t\tiifname "%s" oifname "%s" ip saddr %s meta priority set %s:%s return\n' "$lan_if" "$wan_if" "$ip" "$WAN_HANDLE" "$slowid"
			classid=$((classid + 1))
		done < "$DEVICES_FILE"
		printf '\t\tiifname "%s" oifname "%s" ip daddr @priority_v4 counter name internet_down counter name priority_down return\n' "$wan_if" "$lan_if"
		printf '\t\tiifname "%s" oifname "%s" ip daddr %s ip daddr != @priority_v4 counter name internet_down counter name others_down\n' "$wan_if" "$lan_if" "$subnet"
		classid=101
		while IFS="$tab" read -r id mac ip name; do
			[ -z "$id" ] && continue
			slowid=$((classid + SLOW_OFFSET))
			printf '\t\tiifname "%s" oifname "%s" ip daddr %s quota name q_%s meta priority set %s:%s return\n' "$wan_if" "$lan_if" "$ip" "$id" "$LAN_HANDLE" "$classid"
			printf '\t\tiifname "%s" oifname "%s" ip daddr %s meta priority set %s:%s return\n' "$wan_if" "$lan_if" "$ip" "$LAN_HANDLE" "$slowid"
			classid=$((classid + 1))
		done < "$DEVICES_FILE"
		printf '\t}\n}\n'
	} | nft -f -
}

accounting_table_owned() {
	nft list table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null | grep -Fq "comment \"$OWNER_COMMENT\""
}

reset_period_if_due() {
	local now_day now_hour now_minute name
	now_day="$(date +%F)"
	if [ -z "$period_day" ]; then
		case "$now_day" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) period_day="$now_day" ;; *) return 1 ;; esac
		return 0
	fi
	case "$now_day:$period_day" in
		[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]:[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
		*) return 0 ;;
	esac
	now_hour="$(date +%H)"; now_minute="$(date +%M)"
	now_hour="${now_hour#0}"; now_minute="${now_minute#0}"
	[ -n "$now_hour" ] || now_hour=0; [ -n "$now_minute" ] || now_minute=0
	now_minute=$((now_hour * 60 + now_minute))
	# ISO dates sort chronologically. Never reset backwards while pre-NTP time is
	# older than the durable period.
	[ "$now_day" \> "$period_day" ] && [ "$now_minute" -ge "$reset_at_minute" ] || return 0
	period_day="$now_day"
	for name in internet_up internet_down priority_up priority_down others_up others_down; do eval "$name=0"; done
	deliberate_daily_reset=1
	# Replace first. If the nft transaction fails, the old durable day remains
	# authoritative and respawn retries instead of committing a false zero.
	live_table_present=0
	install_table || return 1
	read_counters || return 1
	rm -rf "$DEVICE_STATE_DIR" || return 1
	rm -f "$MIGRATION_FILE" || return 1
	migration_active=0; migration_seed=0
	persist_values || return 1
	deliberate_daily_reset=0
}

handle_persist_failure() {
	force_degraded=1
	install_table >/dev/null 2>&1 || return 1
	write_runtime error 'No se pudo guardar el estado; Otros queda limitado a 64 Kbit/s de forma preventiva.'
}

update_runtime_message() {
	if [ "$degraded_count" -gt 0 ]; then
		write_runtime active "$degraded_count dispositivo(s) agotaron su cuota y están limitados a 64 Kbit/s."
	else
		write_runtime active 'Contabilidad diaria individual verificada.'
	fi
}

cleanup() {
	nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || { write_runtime error 'La tabla de contabilidad desapareció; el estado permanece marcado como abierto.'; exit 1; }
	accounting_table_owned || { write_runtime error 'La tabla de contabilidad no conserva la firma propia; no se tocó.'; exit 1; }
	persist_state >/dev/null 2>&1 || { write_runtime error 'No se pudo guardar el estado; la cuota permanece instalada.'; exit 1; }
	if [ -f "$HANDOFF_FILE" ] && [ ! -L "$HANDOFF_FILE" ]; then
		# Keep the verified table only for an explicitly requested successor.
		mark_runtime_clean || { write_runtime error 'No se pudo cerrar el estado durable.'; exit 1; }
		write_runtime stopped 'Contabilidad en relevo; la última cuota verificada permanece aplicada.'
	else
		nft delete table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null || { write_runtime error 'No se pudo retirar la tabla propia al detener el servicio.'; exit 1; }
		nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 && { write_runtime error 'La tabla propia sigue activa después de detener el servicio.'; exit 1; }
		mark_runtime_clean || { write_runtime error 'No se pudo cerrar el estado durable.'; exit 1; }
		write_runtime stopped 'Contabilidad detenida y tabla propia retirada.'
	fi
	exit 0
}

main() {
	local now_epoch delta
	force_degraded=0
	deliberate_daily_reset=0
	mkdir -p "$RUN_DIR" || exit 1
	command -v nft >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1 && command -v awk >/dev/null 2>&1 || { write_runtime error 'Faltan nftables, jsonfilter o awk.'; exit 1; }
	load_settings || { write_runtime error 'Configuración, dispositivos o interfaz WAN no válidos.'; exit 1; }
	inspect_previous_session || { write_runtime error 'El marcador de persistencia no es seguro.'; exit 1; }
	inspect_boot || { write_runtime error 'No se pudo verificar la identidad del arranque.'; exit 1; }
	load_saved_counters
	inspect_existing_table || { write_runtime error 'Existe una tabla de contabilidad sin la firma propia; no se tocó.'; exit 1; }
	merge_live_counters || { write_runtime error 'No se pudieron recuperar los contadores de la tabla anterior.'; exit 1; }
	snapshot_live_quotas || { write_runtime error 'No se pudieron recuperar las cuotas de la tabla anterior.'; exit 1; }
	ensure_offloading_disabled || { write_runtime error 'No se pudo desactivar flow offloading.'; exit 1; }
	inspect_existing_table || { write_runtime error 'Existe una tabla de contabilidad sin la firma propia; no se tocó.'; exit 1; }
	reset_period_if_due || { write_runtime error 'No se pudo iniciar el periodo diario.'; exit 1; }
	# period_day must be resolved before validating the migration seed. The seed
	# still takes precedence over a deliberate daily reset.
	load_migration_seed
	mark_runtime_dirty || { write_runtime error 'No se pudo abrir una sesión durable de contabilidad.'; exit 1; }
	install_table || { write_runtime error 'No se pudo instalar la contabilidad individual.'; exit 1; }
	deliberate_daily_reset=0
	read_counters || { write_runtime error 'No se pudieron leer los objetos nftables.'; exit 1; }
	persist_values || { handle_persist_failure; exit 1; }
	persist_table_ids || { handle_persist_failure; exit 1; }
	persist_boot_id || { handle_persist_failure; exit 1; }
	if [ "$migration_active" = '1' ]; then
		rm -f "$MIGRATION_FILE" && sync || { handle_persist_failure; exit 1; }
		migration_active=0
	fi
	rm -f "$HANDOFF_FILE" "$LIVE_SEEDS_FILE"
	trap cleanup TERM INT
	last_persist_epoch="$(date +%s)"
	last_persist_total="$device_total_used"
	update_runtime_message
	while sleep "$POLL_INTERVAL"; do
		nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || { write_runtime error 'La tabla nftables desapareció; se reintentará el servicio.'; exit 1; }
		reset_period_if_due || { write_runtime error 'No se pudo completar de forma durable el reset diario.'; exit 1; }
		read_counters || { write_runtime error 'No se pudieron leer los objetos nftables.'; exit 1; }
		now_epoch="$(date +%s)"
		delta="$(awk -v a="$device_total_used" -v b="$last_persist_total" 'BEGIN { printf "%.0f", a - b }')"
		if [ $((now_epoch - last_persist_epoch)) -ge "$persist_interval" ] || uint_ge "$delta" "$persist_step"; then
			persist_values || { handle_persist_failure; exit 1; }
		fi
		update_runtime_message
	done
}

main "$@"
