# Las configuraciones son conffiles: v4 sustituyó la cuota grupal por cuotas
# individuales; v5 elimina reservas hipotéticas acumulables y admite ajustes.

write_v4_migration() {
	local state='/etc/nano-monitor/daily-state' marker='/etc/nano-monitor/v4-migration' day
	day="$(sed -n 's/^day=//p' "$state" 2>/dev/null | sed -n '1p')"
	case "$day" in ????-??-??) ;; *) day="$(date +%F)" ;; esac
	mkdir -p -m 0700 /etc/nano-monitor || return 1
	[ ! -L /etc/nano-monitor ] && [ ! -L "$marker" ] && [ ! -L "$marker.tmp" ] || return 1
	rm -f "$marker.tmp" || return 1
	umask 077
	# El estado grupal anterior no contiene una relación MAC→consumo. Mantener
	# Otros en el perfil preventivo hasta el reset conserva servicio a 64 Kbit/s
	# sin inventar consumo individual ni conceder cuotas nuevas a mitad del día.
	{
		printf 'day=%s\n' "$day"
		printf 'mode=identity-unknown-hold\n'
	} > "$marker.tmp" && mv "$marker.tmp" "$marker" && sync || return 1
	[ "$(sed -n 's/^day=//p' "$marker" | sed -n '1p')" = "$day" ] &&
		[ "$(sed -n 's/^mode=//p' "$marker" | sed -n '1p')" = 'identity-unknown-hold' ]
}

legacy_bwlimit_script_owned() {
	[ -f /etc/init.d/bwlimit ] || return 1
	{ grep -Fq 'TABLE_NAME="bwlimit"' /etc/init.d/bwlimit || grep -Fq "TABLE_NAME='bwlimit'" /etc/init.d/bwlimit; } && grep -Fq 'bwlimit-drop' /etc/init.d/bwlimit
}

legacy_bwlimit_table_owned() {
	local rules lan subnet
	lan="$(uci -q get bwlimit.main.lan_if)"; subnet="$(uci -q get bwlimit.main.subnet)"
	[ -n "$lan" ] || lan='br-lan'; [ -n "$subnet" ] || subnet='192.168.1.0/24'
	rules="$(nft list table inet bwlimit 2>/dev/null)" || return 1
	printf '%s\n' "$rules" | grep -Fq 'chain forward {' || return 1
	printf '%s\n' "$rules" | grep -F "iifname \"$lan\" ip saddr $subnet" | grep -Fq 'limit rate over' || return 1
	printf '%s\n' "$rules" | grep -F "oifname \"$lan\" ip daddr $subnet" | grep -Fq 'limit rate over'
}

needs_identity_hold=0
if uci -q get bwlimit.main >/dev/null; then
	previous_schema="$(uci -q get bwlimit.main.schema_version)"
	checkpoint_model="$(uci -q get bwlimit.main.accounting_checkpoint_model)"
	# r15 podía avanzar a schema 5 desde schema 4 sin crear el marcador. La
	# ausencia del modelo exact-v1 identifica también esa transición incompleta.
	# En ambos casos los checkpoints por dispositivo son no autoritativos.
	if [ "$previous_schema" != '5' ] || [ "$checkpoint_model" != 'exact-v1' ]; then
		needs_identity_hold=1
	fi
	[ -n "$(uci -q get bwlimit.main.wan_network)" ] || uci -q set bwlimit.main.wan_network='provider'
	if [ "$previous_schema" != '3' ] && [ "$previous_schema" != '4' ] && [ "$previous_schema" != '5' ]; then
		uci -q set bwlimit.main.total_down_kbit='8800'
		uci -q set bwlimit.main.total_up_kbit='4200'
		uci -q delete bwlimit.main.exempt_ip
		uci -q add_list bwlimit.main.exempt_ip='192.168.1.58'
		uci -q add_list bwlimit.main.exempt_ip='192.168.1.59'
	else
		[ -n "$(uci -q get bwlimit.main.total_down_kbit)" ] || uci -q set bwlimit.main.total_down_kbit='8800'
		[ -n "$(uci -q get bwlimit.main.total_up_kbit)" ] || uci -q set bwlimit.main.total_up_kbit='4200'
	fi
	if [ "$previous_schema" != '4' ] && [ "$previous_schema" != '5' ]; then
		uci -q set bwlimit.main.other_down_kbit='768'
		uci -q set bwlimit.main.other_up_kbit='128'
		uci -q set bwlimit.main.other_degraded_kbit='64'
		uci -q set bwlimit.main.quota_per_device_bytes='700000000'
		uci -q delete bwlimit.main.other_min_down_kbit
		uci -q delete bwlimit.main.other_min_up_kbit
		uci -q delete bwlimit.main.quota_bytes
	fi
	[ -n "$(uci -q get bwlimit.main.enabled)" ] || uci -q set bwlimit.main.enabled='1'
	[ -n "$(uci -q get bwlimit.main.other_down_kbit)" ] || uci -q set bwlimit.main.other_down_kbit='768'
	[ -n "$(uci -q get bwlimit.main.other_up_kbit)" ] || uci -q set bwlimit.main.other_up_kbit='128'
	[ -n "$(uci -q get bwlimit.main.other_degraded_kbit)" ] || uci -q set bwlimit.main.other_degraded_kbit='64'
	# La cuota individual es parte obligatoria del contrato 1.4.0; no se publica
	# un interruptor que el runtime ignore.
	uci -q set bwlimit.main.quota_enabled='1'
	[ -n "$(uci -q get bwlimit.main.quota_per_device_bytes)" ] || uci -q set bwlimit.main.quota_per_device_bytes='700000000'
	[ -n "$(uci -q get bwlimit.main.quota_reset_hour)" ] || uci -q set bwlimit.main.quota_reset_hour='0'
	[ -n "$(uci -q get bwlimit.main.quota_reset_minute)" ] || uci -q set bwlimit.main.quota_reset_minute='1'
	[ -n "$(uci -q get bwlimit.main.quota_persist_interval)" ] || uci -q set bwlimit.main.quota_persist_interval='1800'
	[ -n "$(uci -q get bwlimit.main.quota_persist_step_bytes)" ] || uci -q set bwlimit.main.quota_persist_step_bytes='64000000'
	# El hold durable se confirma antes de declarar el modelo exacto. Durante el
	# hold el daemon ignora todos los checkpoints por dispositivo y sólo los
	# sustituye por ceros después de verificar la tabla preventiva.
	[ "$needs_identity_hold" = '0' ] || write_v4_migration || exit 1
	uci -q set bwlimit.main.schema_version='5' || exit 1
	uci -q set bwlimit.main.accounting_checkpoint_model='exact-v1' || exit 1
	uci -q commit bwlimit || {
		uci -q revert bwlimit.main.schema_version
		uci -q revert bwlimit.main.accounting_checkpoint_model
		exit 1
	}
fi

# La contabilidad diaria se calcula explícitamente en la zona del propietario.
uci -q set system.@system[0].zonename='America/New_York'
uci -q set system.@system[0].timezone='EST5EDT,M3.2.0,M11.1.0'
uci -q commit system

# Tanto los contadores forward como HTB requieren que los flujos no los eludan.
# Es una invariante del paquete completo, no una mutación temporal del shaper.
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall
/etc/init.d/firewall restart >/dev/null 2>&1

/etc/init.d/nano-accounting enable >/dev/null 2>&1
# La versión anterior instalaba este limitador. Sólo se retiran el servicio y
# la tabla cuando conservan su firma exacta; nlbwmon puede ser uso del dueño y
# no interfiere con los contadores propios.
legacy_bwlimit_owned=0
if legacy_bwlimit_script_owned; then
	legacy_bwlimit_owned=1
	/etc/init.d/bwlimit stop >/dev/null 2>&1
	/etc/init.d/bwlimit disable >/dev/null 2>&1
fi
if nft list table inet bwlimit >/dev/null 2>&1; then
	legacy_bwlimit_table_owned || exit 1
	legacy_bwlimit_owned=1
	nft delete table inet bwlimit >/dev/null 2>&1 || exit 1
	nft list table inet bwlimit >/dev/null 2>&1 && exit 1
fi
[ "$legacy_bwlimit_owned" = '0' ] || rm -f /etc/rc.d/S??bwlimit /etc/rc.d/K??bwlimit
if [ "$(uci -q get bwlimit.main.enabled)" = '1' ]; then
	/etc/init.d/nano-shaper enable >/dev/null 2>&1
else
	/etc/init.d/nano-shaper disable >/dev/null 2>&1
fi

exit 0
