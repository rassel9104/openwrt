#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (C) 2026 RaykTo <raktodev@gmail.com>

START=96
STOP=10
USE_PROCD=1

STATE_DIR='/var/run/nano-shaper'
TABLE_FAMILY='inet'
TABLE_NAME='nano_shaper'

write_state() {
	local state="$1" message="$2"
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$state" > "$STATE_DIR/state.tmp"
	printf '%s\n' "$message" > "$STATE_DIR/message.tmp"
	mv "$STATE_DIR/state.tmp" "$STATE_DIR/state"
	mv "$STATE_DIR/message.tmp" "$STATE_DIR/message"
}

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_iface() {
	case "$1" in
		''|*[!A-Za-z0-9_.:-]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_ipv4() {
	local ip="$1" a b c d extra octet
	case "$ip" in *[!0-9.]*|'') return 1 ;; esac
	IFS=. read -r a b c d extra <<EOF
$ip
EOF
	[ -n "$a" ] && [ -n "$b" ] && [ -n "$c" ] && [ -n "$d" ] && [ -z "$extra" ] || return 1
	for octet in "$a" "$b" "$c" "$d"; do
		is_uint "$octet" && [ "$octet" -le 255 ] || return 1
	done
}

add_priority_ip() {
	local ip="$1"
	valid_ipv4 "$ip" || return
	PRIORITY_IPS="${PRIORITY_IPS}${PRIORITY_IPS:+ }$ip"
	PRIORITY_SET="${PRIORITY_SET}${PRIORITY_SET:+, }$ip"
}

is_priority_ip() {
	case " $PRIORITY_IPS " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

add_other_ip() {
	local ip="$1"
	valid_ipv4 "$ip" || return
	is_priority_ip "$ip" && return
	case " $OTHER_IPS " in *" $ip "*) return ;; esac
	OTHER_IPS="${OTHER_IPS}${OTHER_IPS:+ }$ip"
	other_count=$((other_count + 1))
}

collect_reservation() {
	local section="$1" ip mac
	config_get ip "$section" ip
	config_get mac "$section" mac
	if [ -n "$ip" ] && [ -n "$mac" ]; then
		RESERVED_IPS="$RESERVED_IPS $ip "
		add_other_ip "$ip"
	fi
}

load_settings() {
	config_load bwlimit
	config_get_bool enabled main enabled 0
	config_get lan_if main lan_if 'br-lan'
	config_get wan_network main wan_network 'provider'
	config_get subnet main subnet '192.168.1.0/24'
	config_get total_down_kbit main total_down_kbit '8800'
	config_get total_up_kbit main total_up_kbit '4200'
	config_get configured_other_down main other_min_down_kbit '500'
	config_get configured_other_up main other_min_up_kbit '128'

	PRIORITY_IPS=''
	PRIORITY_SET=''
	config_list_foreach main exempt_ip add_priority_ip
	[ -n "$PRIORITY_IPS" ] || return 1

	status="$(ubus call "network.interface.$wan_network" status 2>/dev/null)"
	wan_if="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)"
	valid_iface "$lan_if" && valid_iface "$wan_if" || return 1
	[ -d "/sys/class/net/$lan_if" ] && [ -d "/sys/class/net/$wan_if" ] || return 1

	for value in "$total_down_kbit" "$total_up_kbit" "$configured_other_down" "$configured_other_up"; do
		is_uint "$value" || return 1
	done
	[ "$total_down_kbit" -ge 512 ] && [ "$total_up_kbit" -ge 256 ] || return 1
	[ "$configured_other_down" -ge 64 ] && [ "$configured_other_down" -lt "$total_down_kbit" ] || return 1
	[ "$configured_other_up" -ge 64 ] && [ "$configured_other_up" -lt "$total_up_kbit" ] || return 1

	RESERVED_IPS=''
	OTHER_IPS=''
	other_count=0
	config_load dhcp
	config_foreach collect_reservation host
	for ip in $PRIORITY_IPS; do
		case "$RESERVED_IPS" in *" $ip "*) ;; *) return 1 ;; esac
	done
	if [ -r /tmp/dhcp.leases ]; then
		while read -r _expires _mac ip _name _client; do
			add_other_ip "$ip"
		done < /tmp/dhcp.leases
	fi

	# Reserve one additional class for traffic not yet represented in DHCP.
	# This keeps the sum of child guarantees within the parent HTB rate.
	reserve_count=$((other_count + 1))
	other_down_kbit="$configured_other_down"
	other_up_kbit="$configured_other_up"
	[ $((other_down_kbit * reserve_count)) -le $((total_down_kbit - 64)) ] || other_down_kbit=$(((total_down_kbit - 64) / reserve_count))
	[ $((other_up_kbit * reserve_count)) -le $((total_up_kbit - 64)) ] || other_up_kbit=$(((total_up_kbit - 64) / reserve_count))
	priority_down_kbit=$((total_down_kbit - other_down_kbit * reserve_count))
	priority_up_kbit=$((total_up_kbit - other_up_kbit * reserve_count))
	[ "$priority_down_kbit" -ge 64 ] && [ "$priority_up_kbit" -ge 64 ] || return 1
}

ensure_offloading_disabled() {
	local changed=0 rules
	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = '0' ] || {
		uci -q set firewall.@defaults[0].flow_offloading='0' || return 1
		changed=1
	}
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = '0' ] || {
		uci -q set firewall.@defaults[0].flow_offloading_hw='0' || return 1
		changed=1
	}
	[ "$changed" = '0' ] || {
		uci -q commit firewall || return 1
	}
	rules="$(nft list ruleset 2>/dev/null)" || return 1
	if [ "$changed" != '0' ] || printf '%s\n' "$rules" | grep -Eq '(^|[[:space:]])flowtable[[:space:]]|flow add @'; then
		/etc/init.d/firewall restart >/dev/null 2>&1 || return 1
		rules="$(nft list ruleset 2>/dev/null)" || return 1
	fi
	printf '%s\n' "$rules" | grep -Eq '(^|[[:space:]])flowtable[[:space:]]|flow add @' && return 1
	return 0
}

root_qdisc_free() {
	local dev="$1" handle="$2" root
	root="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /{p;q;}')"
	case "$root" in
		''|*"qdisc fq_codel 0:"*|*"qdisc noqueue 0:"*) return 0 ;;
		*) return 1 ;;
	esac
}

rollback_new_rules() {
	clear_installing_rules >/dev/null 2>&1
}

clear_owned_rules() {
	[ -f "$STATE_DIR/owned" ] || return 0
	if [ "$(cat "$STATE_DIR/owned" 2>/dev/null)" = 'installing' ]; then
		clear_installing_rules
		return $?
	fi
	owned_rules_verified || return 1
	delete_manifest_root "$saved_wan" 1 || return 1
	delete_manifest_root "$saved_lan" 2 || return 1
	if nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1; then
		nft delete table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null || return 1
	fi
	rm -f "$STATE_DIR/owned"
}

install_classifier() {
	local replace=''
	nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 && replace="delete table $TABLE_FAMILY $TABLE_NAME"
	nft -f - <<EOF
$replace
table $TABLE_FAMILY $TABLE_NAME {
	set priority_v4 {
		type ipv4_addr
		elements = { $PRIORITY_SET }
	}

	chain classify {
		type filter hook forward priority mangle; policy accept;
		iifname "$lan_if" oifname "$wan_if" ip saddr @priority_v4 counter meta priority set 1:10 return
		iifname "$wan_if" oifname "$lan_if" ip daddr @priority_v4 counter meta priority set 2:10 return
	}
}
EOF
}

install_tree() {
	local dev="$1" handle="$2" total="$3" priority_rate="$4" other_rate="$5" direction="$6" ip classid=101
	tc qdisc del dev "$dev" root 2>/dev/null
	tc qdisc add dev "$dev" root handle "$handle:" htb default 20 || return 1
	tc class add dev "$dev" parent "$handle:" classid "$handle:1" htb rate "${total}kbit" ceil "${total}kbit" || return 1
	tc class add dev "$dev" parent "$handle:1" classid "$handle:10" htb rate "${priority_rate}kbit" ceil "${total}kbit" prio 0 quantum 1514 || return 1
	tc class add dev "$dev" parent "$handle:1" classid "$handle:20" htb rate "${other_rate}kbit" ceil "${total}kbit" prio 1 quantum 1514 || return 1
	for class in 10 20; do
		tc qdisc add dev "$dev" parent "$handle:$class" handle "$handle$class:" fq_codel limit 256 target 5ms interval 100ms quantum 1514 ecn || return 1
	done
	for ip in $OTHER_IPS; do
		tc class add dev "$dev" parent "$handle:1" classid "$handle:$classid" htb rate "${other_rate}kbit" ceil "${total}kbit" prio 1 quantum 1514 || return 1
		tc qdisc add dev "$dev" parent "$handle:$classid" handle "$handle$classid:" fq_codel limit 256 target 5ms interval 100ms quantum 1514 ecn || return 1
		tc filter add dev "$dev" parent "$handle:" protocol ip prio 10 u32 match ip "$direction" "$ip/32" flowid "$handle:$classid" || return 1
		classid=$((classid + 1))
	done
}

verify_tree() {
	local dev="$1" handle="$2"
	tc qdisc show dev "$dev" | grep -q "qdisc htb $handle: root" || return 1
	tc qdisc show dev "$dev" | grep -q "qdisc fq_codel ${handle}10:" || return 1
	tc qdisc show dev "$dev" | grep -q "qdisc fq_codel ${handle}20:" || return 1
	tc class show dev "$dev" | grep -q "class htb $handle:10" || return 1
	tc class show dev "$dev" | grep -q "class htb $handle:20" || return 1
}

ipv4_hex() {
	awk -F. '{ printf "%02x%02x%02x%02x", $1, $2, $3, $4 }' <<EOF
$1
EOF
}

filter_mapping_matches() {
	local dev="$1" handle="$2" classid="$3" direction="$4" ip="$5" offset output hex
	[ "$direction" = 'src' ] && offset=12 || offset=16
	hex="$(ipv4_hex "$ip")"
	output="$(tc filter show dev "$dev" parent "$handle:" protocol ip prio 10 2>/dev/null)" || return 1
	printf '%s\n' "$output" | awk -v flow="flowid $handle:$classid" -v key="match $hex/ffffffff at $offset" '
		/^filter / {
			if (has_flow && has_key) ok=1
			has_flow=0; has_key=0
		}
		index($0, flow) { has_flow=1 }
		index($0, key) { has_key=1 }
		END {
			if (has_flow && has_key) ok=1
			exit !ok
		}'
}

verify_other_classes() {
	local dev="$1" handle="$2" direction="$3" rate="$4" ip classid=101
	for ip in $OTHER_IPS; do
		tc class show dev "$dev" | grep -q "class htb $handle:$classid" || return 1
		tc qdisc show dev "$dev" | grep -q "qdisc fq_codel $handle$classid:" || return 1
		class_value_matches "$dev" "$handle:$classid" rate $((rate * 125)) || return 1
		filter_mapping_matches "$dev" "$handle" "$classid" "$direction" "$ip" || return 1
		classid=$((classid + 1))
	done
}

class_value_matches() {
	local dev="$1" classid="$2" field="$3" expected="$4" actual
	actual="$(tc -j class show dev "$dev" classid "$classid" 2>/dev/null | jsonfilter -e "@[0].$field" 2>/dev/null)"
	[ "$actual" = "$expected" ]
}

verify_profile_rates() {
	class_value_matches "$wan_if" 1:1 ceil $((total_up_kbit * 125)) || return 1
	class_value_matches "$wan_if" 1:10 rate $((priority_up_kbit * 125)) || return 1
	class_value_matches "$wan_if" 1:20 rate $((other_up_kbit * 125)) || return 1
	class_value_matches "$lan_if" 2:1 ceil $((total_down_kbit * 125)) || return 1
	class_value_matches "$lan_if" 2:10 rate $((priority_down_kbit * 125)) || return 1
	class_value_matches "$lan_if" 2:20 rate $((other_down_kbit * 125)) || return 1
}

load_manifest() {
	saved_wan="$(cat "$STATE_DIR/wan_if" 2>/dev/null)"
	saved_lan="$(cat "$STATE_DIR/lan_if" 2>/dev/null)"
	saved_total_down="$(cat "$STATE_DIR/total_down_kbit" 2>/dev/null)"
	saved_total_up="$(cat "$STATE_DIR/total_up_kbit" 2>/dev/null)"
	saved_priority_down="$(cat "$STATE_DIR/priority_down_kbit" 2>/dev/null)"
	saved_priority_up="$(cat "$STATE_DIR/priority_up_kbit" 2>/dev/null)"
	saved_other_down="$(cat "$STATE_DIR/other_down_kbit" 2>/dev/null)"
	saved_other_up="$(cat "$STATE_DIR/other_up_kbit" 2>/dev/null)"
	saved_other_ips="$(cat "$STATE_DIR/other_ips" 2>/dev/null)"
	valid_iface "$saved_wan" && valid_iface "$saved_lan" || return 1
	for value in "$saved_total_down" "$saved_total_up" "$saved_priority_down" "$saved_priority_up" "$saved_other_down" "$saved_other_up"; do
		is_uint "$value" || return 1
	done
	for ip in $saved_other_ips; do valid_ipv4 "$ip" || return 1; done
}

save_manifest() {
	mkdir -p "$STATE_DIR" || return 1
	printf '%s\n' "$wan_if" > "$STATE_DIR/wan_if" || return 1
	printf '%s\n' "$lan_if" > "$STATE_DIR/lan_if" || return 1
	printf '%s\n' "$total_down_kbit" > "$STATE_DIR/total_down_kbit" || return 1
	printf '%s\n' "$total_up_kbit" > "$STATE_DIR/total_up_kbit" || return 1
	printf '%s\n' "$priority_down_kbit" > "$STATE_DIR/priority_down_kbit" || return 1
	printf '%s\n' "$priority_up_kbit" > "$STATE_DIR/priority_up_kbit" || return 1
	printf '%s\n' "$other_down_kbit" > "$STATE_DIR/other_down_kbit" || return 1
	printf '%s\n' "$other_up_kbit" > "$STATE_DIR/other_up_kbit" || return 1
	printf '%s\n' "$OTHER_IPS" > "$STATE_DIR/other_ips" || return 1
	printf '%s\n' "$other_count" > "$STATE_DIR/other_count" || return 1
	printf '%s\n' installing > "$STATE_DIR/owned" || return 1
}

manifest_tree_verified_or_absent() {
	local dev="$1" handle="$2" total="$3" priority="$4" other="$5" direction="$6" ips="$7" root old_ips rc
	[ -d "/sys/class/net/$dev" ] || return 0
	root="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /{p;q;}')"
	case "$root" in
		''|*"qdisc fq_codel 0:"*|*"qdisc noqueue 0:"*) return 0 ;;
		*"qdisc htb $handle: root"*) ;;
		*) return 1 ;;
	esac
	verify_tree "$dev" "$handle" || return 1
	class_value_matches "$dev" "$handle:1" ceil $((total * 125)) || return 1
	class_value_matches "$dev" "$handle:10" rate $((priority * 125)) || return 1
	class_value_matches "$dev" "$handle:20" rate $((other * 125)) || return 1
	old_ips="$OTHER_IPS"
	OTHER_IPS="$ips"
	verify_other_classes "$dev" "$handle" "$direction" "$other"
	rc=$?
	OTHER_IPS="$old_ips"
	return "$rc"
}

delete_manifest_root() {
	local dev="$1" handle="$2" root
	[ -d "/sys/class/net/$dev" ] || return 0
	root="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /{p;q;}')"
	case "$root" in
		''|*"qdisc fq_codel 0:"*|*"qdisc noqueue 0:"*) return 0 ;;
		*"qdisc htb $handle: root"*) tc qdisc del dev "$dev" root ;;
		*) return 1 ;;
	esac
}

manifest_root_absent() {
	local dev="$1" root
	[ -d "/sys/class/net/$dev" ] || return 0
	root="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /{p;q;}')"
	case "$root" in
		''|*"qdisc fq_codel 0:"*|*"qdisc noqueue 0:"*) return 0 ;;
		*) return 1 ;;
	esac
}

clear_installing_rules() {
	local marker rules pair dev handle root
	marker="$(cat "$STATE_DIR/owned" 2>/dev/null)"
	[ "$marker" = 'installing' ] || return 1
	load_manifest || return 1
	# The marker and manifest are written before any mutation, while both roots
	# are verified free. During installation, only these two private handles and
	# this private nft table can therefore be partial package-owned state.
	for pair in "$saved_wan:1" "$saved_lan:2"; do
		dev="${pair%:*}"
		handle="${pair##*:}"
		[ -d "/sys/class/net/$dev" ] || continue
		root="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /{p;q;}')"
		case "$root" in
			''|*"qdisc fq_codel 0:"*|*"qdisc noqueue 0:"*) ;;
			*"qdisc htb $handle: root"*) ;;
			*) return 1 ;;
		esac
	done
	if rules="$(nft list table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null)"; then
		printf '%s\n' "$rules" | grep -Fq "iifname \"$saved_lan\" oifname \"$saved_wan\"" || return 1
		printf '%s\n' "$rules" | grep -Fq "iifname \"$saved_wan\" oifname \"$saved_lan\"" || return 1
		printf '%s\n' "$rules" | grep -Fq 'meta priority set 1:10' || return 1
		printf '%s\n' "$rules" | grep -Fq 'meta priority set 2:10' || return 1
	fi
	delete_manifest_root "$saved_wan" 1 || return 1
	delete_manifest_root "$saved_lan" 2 || return 1
	if nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1; then
		nft delete table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null || return 1
	fi
	manifest_root_absent "$saved_wan" || return 1
	manifest_root_absent "$saved_lan" || return 1
	nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 && return 1
	rm -f "$STATE_DIR/owned"
}

owned_rules_verified() {
	local rules
	[ -f "$STATE_DIR/owned" ] || return 1
	load_manifest || return 1
	manifest_tree_verified_or_absent "$saved_wan" 1 "$saved_total_up" "$saved_priority_up" "$saved_other_up" src "$saved_other_ips" || return 1
	manifest_tree_verified_or_absent "$saved_lan" 2 "$saved_total_down" "$saved_priority_down" "$saved_other_down" dst "$saved_other_ips" || return 1
	if rules="$(nft list table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null)"; then
		printf '%s\n' "$rules" | grep -Fq "iifname \"$saved_lan\" oifname \"$saved_wan\"" || return 1
		printf '%s\n' "$rules" | grep -Fq "iifname \"$saved_wan\" oifname \"$saved_lan\"" || return 1
		printf '%s\n' "$rules" | grep -Fq 'meta priority set 1:10' || return 1
		printf '%s\n' "$rules" | grep -Fq 'meta priority set 2:10' || return 1
	fi
}

write_failure_state() {
	local reason="$1"
	write_state error "$reason Internet queda sin shaping."
}

start_service() {
	WAN_TOUCHED=0
	LAN_TOUCHED=0
	command -v tc >/dev/null 2>&1 && command -v nft >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1 || {
		write_failure_state 'Faltan herramientas de shaping.'
		return 1
	}
	config_load bwlimit
	config_get_bool enabled main enabled 0
	if [ "$enabled" != '1' ]; then
		if [ -f "$STATE_DIR/owned" ]; then
			clear_owned_rules || {
				write_failure_state 'El shaping activo no coincide con la firma propia; no se tocó.'
				return 1
			}
		fi
		write_state disabled 'Shaping desactivado.'
		return 0
	fi

	load_settings || {
		write_failure_state 'Configuración, interfaz WAN o reservas prioritarias no válidas.'
		return 1
	}
	if [ -f "$STATE_DIR/owned" ]; then
		clear_owned_rules || {
			write_failure_state 'El shaping anterior no coincide con su manifiesto; no se tocó.'
			return 1
		}
	fi

	root_qdisc_free "$wan_if" 1 && root_qdisc_free "$lan_if" 2 || {
		write_failure_state 'Existe un qdisc ajeno; no se reemplazó.'
		return 1
	}

	ensure_offloading_disabled || {
		write_failure_state 'No se pudo desactivar flow offloading.'
		return 1
	}
	save_manifest || {
		write_failure_state 'No se pudo guardar el manifiesto de propiedad.'
		return 1
	}

	if ! install_classifier; then
		rollback_new_rules
		write_failure_state 'Falló el clasificador nftables.'
		return 1
	fi
	WAN_TOUCHED=1
	if ! install_tree "$wan_if" 1 "$total_up_kbit" "$priority_up_kbit" "$other_up_kbit" src; then
		rollback_new_rules
		write_failure_state 'Falló el árbol HTB de subida.'
		return 1
	fi
	LAN_TOUCHED=1
	if ! install_tree "$lan_if" 2 "$total_down_kbit" "$priority_down_kbit" "$other_down_kbit" dst ||
		! verify_tree "$wan_if" 1 ||
		! verify_tree "$lan_if" 2 ||
		! verify_profile_rates ||
		! verify_other_classes "$wan_if" 1 src "$other_up_kbit" ||
		! verify_other_classes "$lan_if" 2 dst "$other_down_kbit" ||
		! nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1; then
		rollback_new_rules
		write_failure_state 'Falló el readback.'
		return 1
	fi

	nft delete table "$TABLE_FAMILY" bwlimit 2>/dev/null
	/etc/init.d/bwlimit disable >/dev/null 2>&1
	/etc/init.d/bwlimit stop >/dev/null 2>&1
	printf '%s\n' active > "$STATE_DIR/owned"
	write_state active 'Shaping prioritario verificado.'
}

stop_service() {
	if [ -f "$STATE_DIR/owned" ]; then
		clear_owned_rules || {
			write_failure_state 'El shaping activo no coincide con la firma propia; no se tocó.'
			return 1
		}
	fi
	write_state stopped 'Shaping detenido.'
}

reload_service() {
	start_service
}

service_triggers() {
	procd_add_reload_trigger bwlimit
}
