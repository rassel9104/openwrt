START=51
STOP=10
USE_PROCD=1

STATE_DIR='/var/run/nano-shaper'
DEVICES_FILE="$STATE_DIR/devices"
GENERATION_FILE="$STATE_DIR/generation"
PUBLICATION_LOCK="$STATE_DIR/state.lock"
TABLE_FAMILY='inet'
TABLE_NAME='nano_shaper'
GATE_TABLE='nano_shaper_gate'
ACCOUNT_TABLE='nano_accounting'
REGISTRY='/usr/libexec/nano-monitor/device-registry'
. /usr/libexec/nano-monitor/device-policy
OWNER_COMMENT='nano-monitor-owned-v1'
OWNER_CLASS=4095
BASE_RATE_KBIT=1
# Package-reserved major handles. They make the root itself identifiable from
# the first successful tc mutation, before child classes can exist.
WAN_HANDLE=1001
LAN_HANDLE=1002
SLOW_OFFSET=1000
MAX_DEVICES=900
DEFAULT_WAN_QDISC='qdisc fq_codel 0: root refcnt 2 limit 10240p flows 1024 quantum 1414 target 5ms interval 100ms memory_limit 4Mb ecn drop_batch 64'

write_state() {
	local state="$1" message="$2" generation busy stable rc=0
	mkdir -p "$STATE_DIR" || return 1
	[ ! -L "$GENERATION_FILE" ] && [ ! -L "$PUBLICATION_LOCK" ] || return 1
	exec 7>"$PUBLICATION_LOCK" || return 1
	flock -x 7 || { exec 7>&-; return 1; }
	generation="$(sed -n '1p' "$GENERATION_FILE" 2>/dev/null)"
	is_uint "$generation" || generation=0
	[ $((generation % 2)) -eq 0 ] || generation=$((generation + 1))
	busy=$((generation + 1)); stable=$((generation + 2))
	printf '%s\n' "$busy" > "$GENERATION_FILE.tmp" && mv "$GENERATION_FILE.tmp" "$GENERATION_FILE" || rc=1
	if [ "$rc" = '0' ]; then
		printf '%s\n' "$state" > "$STATE_DIR/state.tmp" &&
			printf '%s\n' "$message" > "$STATE_DIR/message.tmp" &&
			mv "$STATE_DIR/state.tmp" "$STATE_DIR/state" &&
			mv "$STATE_DIR/message.tmp" "$STATE_DIR/message" &&
			printf '%s\n' "$stable" > "$GENERATION_FILE.tmp" &&
			mv "$GENERATION_FILE.tmp" "$GENERATION_FILE" || rc=1
	fi
	flock -u 7; exec 7>&-
	return "$rc"
}

is_uint() {
	case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

valid_iface() {
	case "$1" in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; *) return 0 ;; esac
}

valid_ipv4() {
	local ip="$1" a b c d extra octet
	case "$ip" in ''|*[!0-9.]*) return 1 ;; esac
	IFS=. read -r a b c d extra <<EOF
$ip
EOF
	[ -n "$a" ] && [ -n "$b" ] && [ -n "$c" ] && [ -n "$d" ] && [ -z "$extra" ] || return 1
	for octet in "$a" "$b" "$c" "$d"; do is_uint "$octet" && [ "$octet" -le 255 ] || return 1; done
}

add_priority_ip() {
	valid_ipv4 "$1" || return
	PRIORITY_IPS="${PRIORITY_IPS}${PRIORITY_IPS:+ }$1"
	PRIORITY_SET="${PRIORITY_SET}${PRIORITY_SET:+, }$1"
}

collect_reservation() {
	local section="$1" ip mac
	config_get ip "$section" ip
	config_get mac "$section" mac
	[ -n "$ip" ] && [ -n "$mac" ] && RESERVED_IPS="$RESERVED_IPS $ip "
}

load_settings() {
	local status value tab id mac ip name period_day registry tmp="$DEVICES_FILE.tmp"
	config_load bwlimit
	config_get_bool enabled main enabled 0
	config_get lan_if main lan_if 'br-lan'
	config_get wan_network main wan_network 'provider'
	config_get total_down_kbit main total_down_kbit '8800'
	config_get total_up_kbit main total_up_kbit '4200'
	config_get other_down_kbit main other_down_kbit '768'
	config_get other_up_kbit main other_up_kbit '128'
	config_get degraded_kbit main other_degraded_kbit '64'
	config_get quota_bytes main quota_per_device_bytes '700000000'
	PRIORITY_IPS=''; PRIORITY_SET=''
	config_list_foreach main exempt_ip add_priority_ip
	[ -n "$PRIORITY_IPS" ] || return 1
	status="$(ubus call "network.interface.$wan_network" status 2>/dev/null)"
	wan_if="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)"
	valid_iface "$lan_if" && valid_iface "$wan_if" || return 1
	[ -d "/sys/class/net/$lan_if" ] && [ -d "/sys/class/net/$wan_if" ] || return 1
	for value in "$total_down_kbit" "$total_up_kbit" "$other_down_kbit" "$other_up_kbit" "$degraded_kbit" "$quota_bytes"; do is_uint "$value" || return 1; done
	[ "$total_down_kbit" -ge 512 ] && [ "$total_up_kbit" -ge 256 ] || return 1
	[ "$degraded_kbit" -ge 32 ] || return 1
	[ "$other_down_kbit" -ge "$degraded_kbit" ] && [ "$other_down_kbit" -lt "$total_down_kbit" ] || return 1
	[ "$other_up_kbit" -ge "$degraded_kbit" ] && [ "$other_up_kbit" -lt "$total_up_kbit" ] || return 1
	RESERVED_IPS=''
	config_load dhcp
	config_foreach collect_reservation host
	for ip in $PRIORITY_IPS; do case "$RESERVED_IPS" in *" $ip "*) ;; *) return 1 ;; esac; done
	[ -x "$REGISTRY" ] || return 1
	# Accounting starts one init slot earlier, but procd may not have published its
	# volatile snapshot yet. Speeds are day-independent, so use the durable period
	# (then the formatted wall date) only during that narrow boot convergence.
	period_day="$(sed -n 's/^day=//p' /var/run/nano-accounting/current-snapshot 2>/dev/null | sed -n '1p')"
	case "$period_day" in ????-??-??) ;; *) period_day="$(sed -n 's/^day=//p' /etc/nano-monitor/daily-state 2>/dev/null | sed -n '1p')" ;; esac
	case "$period_day" in ????-??-??) ;; *) period_day="$(date +%F)" ;; esac
	case "$period_day" in ????-??-??) ;; *) return 1 ;; esac
	[ ! -L "$DEVICES_FILE" ] || return 1
	: > "$tmp" || return 1
	registry="$($REGISTRY)" || { rm -f "$tmp"; return 1; }
	OTHER_IPS=''; other_count=0
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip name; do
		[ -z "$id" ] && continue
		valid_ipv4 "$ip" || { rm -f "$tmp"; return 1; }
		load_device_policy "$id" "$mac" "$period_day" "$quota_bytes" "$other_down_kbit" "$other_up_kbit" "$total_down_kbit" "$total_up_kbit" "$degraded_kbit" || { rm -f "$tmp"; return 1; }
		printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$mac" "$ip" "$POLICY_DOWN_KBIT" "$POLICY_UP_KBIT" >> "$tmp" || { rm -f "$tmp"; return 1; }
		OTHER_IPS="${OTHER_IPS}${OTHER_IPS:+ }$ip"
		other_count=$((other_count + 1))
		[ "$other_count" -le "$MAX_DEVICES" ] || { rm -f "$tmp"; return 1; }
	done <<EOF
$registry
EOF
	mv "$tmp" "$DEVICES_FILE" || return 1
	# Kept only in the ownership manifest so releases that predate the direct
	# priority path remain safely removable. Priority traffic has no HTB class.
	priority_down_kbit=0
	priority_up_kbit=0
}

ensure_offloading_disabled() {
	local changed=0 rules
	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = '0' ] || { uci -q set firewall.@defaults[0].flow_offloading='0' || return 1; changed=1; }
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = '0' ] || { uci -q set firewall.@defaults[0].flow_offloading_hw='0' || return 1; changed=1; }
	[ "$changed" = '0' ] || uci -q commit firewall || return 1
	rules="$(nft list ruleset 2>/dev/null)" || return 1
	if [ "$changed" != '0' ] || printf '%s\n' "$rules" | grep -Eq '(^|[[:space:]])flowtable[[:space:]]|flow add @'; then
		/etc/init.d/firewall restart >/dev/null 2>&1 || return 1
		rules="$(nft list ruleset 2>/dev/null)" || return 1
	fi
	! printf '%s\n' "$rules" | grep -Eq '(^|[[:space:]])flowtable[[:space:]]|flow add @'
}

read_root_qdisc() {
	local dev="$1" output
	output="$(tc qdisc show dev "$dev" 2>/dev/null)" || return 1
	# iproute2 may print a harmless trailing blank after the final qdisc value.
	# Trim only trailing whitespace, then keep the exact signed comparison below.
	ROOT_QDISC="$(printf '%s\n' "$output" | sed -n '/ root /{s/[[:space:]]*$//;p;q;}')"
}

root_qdisc_free() {
	local dev="$1" root
	read_root_qdisc "$dev" || return 1
	root="$ROOT_QDISC"
	case "$root" in
		''|*'qdisc noqueue 0:'*) return 0 ;;
		*) [ "$root" = "$DEFAULT_WAN_QDISC" ] ;;
	esac
}

acquire_tc_lock() {
	local attempt=0
	command -v flock >/dev/null 2>&1 || return 1
	[ ! -L /var/run/nano-tc.lock ] || return 1
	exec 8>/var/run/nano-tc.lock || return 1
	while ! flock -n 8; do
		[ "$attempt" -lt 5 ] || return 1
		attempt=$((attempt + 1))
		sleep 1
	done
}

exclusive_tc_authority_ok() {
	local service
	# Nano Monitor is the configured owner of these two roots. Refuse automatic
	# replacement when a known competing OpenWrt qdisc manager is enabled.
	for service in sqm qos; do
		if [ -x "/etc/init.d/$service" ] && /etc/init.d/"$service" enabled >/dev/null 2>&1; then
			return 1
		fi
	done
}

gate_owned() {
	nft list table "$TABLE_FAMILY" "$GATE_TABLE" 2>/dev/null | grep -Fq "comment \"$OWNER_COMMENT\""
}

gate_current_ok() {
	local rules ip
	rules="$(nft list table "$TABLE_FAMILY" "$GATE_TABLE" 2>/dev/null)" || return 1
	printf '%s\n' "$rules" | grep -Fq "comment \"$OWNER_COMMENT\"" || return 1
	printf '%s\n' "$rules" | grep -F "iifname \"$lan_if\" oifname \"$wan_if\"" | grep -Fq 'drop' || return 1
	printf '%s\n' "$rules" | grep -F "iifname \"$wan_if\" oifname \"$lan_if\"" | grep -Fq 'drop' || return 1
	for ip in $PRIORITY_IPS; do printf '%s\n' "$rules" | grep -Fq "$ip" || return 1; done
}

install_gate() {
	local replace=''
	if nft list table "$TABLE_FAMILY" "$GATE_TABLE" >/dev/null 2>&1; then
		gate_owned || return 1
		replace="delete table $TABLE_FAMILY $GATE_TABLE"
	fi
	{
		[ -z "$replace" ] || printf '%s\n' "$replace"
		cat <<EOF
table $TABLE_FAMILY $GATE_TABLE {
	comment "$OWNER_COMMENT"
	set priority_v4 { type ipv4_addr; elements = { $PRIORITY_SET }; }
	chain transition_gate {
		type filter hook forward priority -7; policy accept;
		iifname "$lan_if" oifname "$wan_if" ip saddr != @priority_v4 drop
		iifname "$wan_if" oifname "$lan_if" ip daddr != @priority_v4 drop
	}
}
EOF
	} | nft -f - || return 1
	gate_current_ok
}

remove_gate() {
	nft list table "$TABLE_FAMILY" "$GATE_TABLE" >/dev/null 2>&1 || return 0
	gate_owned || return 1
	nft delete table "$TABLE_FAMILY" "$GATE_TABLE" || return 1
	! nft list table "$TABLE_FAMILY" "$GATE_TABLE" >/dev/null 2>&1
}

install_classifier() {
	nft -f - <<EOF
table $TABLE_FAMILY $TABLE_NAME {
	comment "$OWNER_COMMENT"
	set priority_v4 { type ipv4_addr; elements = { $PRIORITY_SET }; }
	chain classify {
		type filter hook forward priority mangle; policy accept;
		iifname "$lan_if" oifname "$wan_if" ip saddr @priority_v4 counter meta priority set $WAN_HANDLE:0 return
		iifname "$wan_if" oifname "$lan_if" ip daddr @priority_v4 counter meta priority set $LAN_HANDLE:0 return
	}
	chain local_output {
		type filter hook output priority mangle; policy accept;
		oifname "$wan_if" counter meta priority set $WAN_HANDLE:0 return
		oifname "$lan_if" counter meta priority set $LAN_HANDLE:0 return
	}
}
EOF
}

install_tree_skeleton() {
	local dev="$1" handle="$2" total="$3" root
	# Re-read at the mutation boundary, then atomically replace only an implicit
	# root or OpenWrt's exact default fq_codel. No delete/unshaped window exists.
	read_root_qdisc "$dev" || return 1
	root="$ROOT_QDISC"
	case "$root" in
		''|*'qdisc noqueue 0:'*) ;;
		*) [ "$root" = "$DEFAULT_WAN_QDISC" ] || return 1 ;;
	esac
	# :0 is HTB's direct queue. The nft classifier sends only priority and
	# router-originated traffic there; every unclassified client remains on the
	# fail-safe :20 class.
	tc qdisc replace dev "$dev" root handle "$handle:" htb default 20 || return 1
	[ "$handle" = "$WAN_HANDLE" ] && created_wan=1 || created_lan=1
	tc class add dev "$dev" parent "$handle:" classid "$handle:1" htb rate "${total}kbit" ceil "${total}kbit" || return 1
	tc class add dev "$dev" parent "$handle:1" classid "$handle:20" htb rate "${BASE_RATE_KBIT}kbit" ceil "${degraded_kbit}kbit" prio 2 quantum 1514 || return 1
	tc qdisc add dev "$dev" parent "$handle:20" handle 20: fq_codel limit 256 target 5ms interval 100ms quantum 1514 ecn || return 1
}

verify_tree_skeleton() {
	local dev="$1" handle="$2" total="$3"
	tc qdisc show dev "$dev" | grep -q "qdisc htb $handle: root" || return 1
	class_value_matches "$dev" "$handle:1" ceil $((total * 125)) || return 1
	class_value_matches "$dev" "$handle:20" ceil $((degraded_kbit * 125)) || return 1
	tc qdisc show dev "$dev" | grep -q 'qdisc fq_codel 20:'
}

populate_tree() {
	local dev="$1" handle="$2" direction="$3" forced="$4"
	local tab id mac ip down up normal classid=101 slowid
	# Active-tree readback requires this sentinel in addition to the reserved
	# root handle.
	tc class add dev "$dev" parent "$handle:1" classid "$handle:$OWNER_CLASS" htb rate "${BASE_RATE_KBIT}kbit" ceil "${BASE_RATE_KBIT}kbit" prio 7 quantum 1514 || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip down up; do
		[ -z "$id" ] && continue
		case "$direction" in down) normal="$down" ;; up) normal="$up" ;; *) return 1 ;; esac
		[ -z "$forced" ] || normal="$forced"
		slowid=$((classid + SLOW_OFFSET))
		tc class add dev "$dev" parent "$handle:1" classid "$handle:$classid" htb rate "${BASE_RATE_KBIT}kbit" ceil "${normal}kbit" prio 1 quantum 1514 || return 1
		tc qdisc add dev "$dev" parent "$handle:$classid" handle "$classid:" fq_codel limit 256 target 5ms interval 100ms quantum 1514 ecn || return 1
		tc class add dev "$dev" parent "$handle:1" classid "$handle:$slowid" htb rate "${BASE_RATE_KBIT}kbit" ceil "${degraded_kbit}kbit" prio 2 quantum 1514 || return 1
		tc qdisc add dev "$dev" parent "$handle:$slowid" handle "$slowid:" fq_codel limit 128 target 10ms interval 200ms quantum 1514 ecn || return 1
		classid=$((classid + 1))
	done < "$DEVICES_FILE"
}

class_value_matches() {
	local dev="$1" classid="$2" field="$3" expected="$4" actual
	actual="$(tc -j class show dev "$dev" classid "$classid" 2>/dev/null | jsonfilter -e "@[0].$field" 2>/dev/null)"
	[ "$actual" = "$expected" ]
}

verify_tree() {
	local dev="$1" handle="$2" total="$3" direction="$4" forced="$5"
	local tab id mac ip down up normal classid=101 slowid
	tc qdisc show dev "$dev" | grep -q "qdisc htb $handle: root" || return 1
	class_value_matches "$dev" "$handle:1" ceil $((total * 125)) || return 1
	class_value_matches "$dev" "$handle:$OWNER_CLASS" rate $((BASE_RATE_KBIT * 125)) || return 1
	class_value_matches "$dev" "$handle:20" ceil $((degraded_kbit * 125)) || return 1
	! tc class show dev "$dev" 2>/dev/null | grep -q "^class htb $handle:10 " || return 1
	! tc qdisc show dev "$dev" 2>/dev/null | grep -q "^qdisc fq_codel 10: parent $handle:10 " || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id mac ip down up; do
		[ -z "$id" ] && continue
		case "$direction" in down) normal="$down" ;; up) normal="$up" ;; *) return 1 ;; esac
		[ -z "$forced" ] || normal="$forced"
		slowid=$((classid + SLOW_OFFSET))
		class_value_matches "$dev" "$handle:$classid" rate $((BASE_RATE_KBIT * 125)) || return 1
		class_value_matches "$dev" "$handle:$classid" ceil $((normal * 125)) || return 1
		class_value_matches "$dev" "$handle:$slowid" ceil $((degraded_kbit * 125)) || return 1
		tc qdisc show dev "$dev" | grep -q "qdisc fq_codel $classid:" || return 1
		tc qdisc show dev "$dev" | grep -q "qdisc fq_codel $slowid:" || return 1
		classid=$((classid + 1))
	done < "$DEVICES_FILE"
}

classifier_owned() {
	nft list table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null | grep -Fq "comment \"$OWNER_COMMENT\""
}

local_output_classifier_ok() {
	local rules
	rules="$(nft list chain "$TABLE_FAMILY" "$TABLE_NAME" local_output 2>/dev/null)" || return 1
	printf '%s\n' "$rules" | grep -Fq 'type filter hook output priority mangle; policy accept;' || return 1
	printf '%s\n' "$rules" | grep -F "oifname \"$wan_if\"" | grep -Fq "meta priority set $WAN_HANDLE:0 return" || return 1
	printf '%s\n' "$rules" | grep -F "oifname \"$lan_if\"" | grep -Fq "meta priority set $LAN_HANDLE:0 return"
}

legacy_classifier_owned() {
	local rules
	rules="$(nft list table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null)" || return 1
	printf '%s\n' "$rules" | grep -Fq 'chain classify {' || return 1
	printf '%s\n' "$rules" | grep -F "iifname \"$saved_lan\" oifname \"$saved_wan\"" | grep -Fq 'meta priority set 1:10' || return 1
	printf '%s\n' "$rules" | grep -F "iifname \"$saved_wan\" oifname \"$saved_lan\"" | grep -Fq 'meta priority set 2:10'
}

accounting_classifier_ok() {
	local rules ip classid=101 slowid
	rules="$(nft list table inet "$ACCOUNT_TABLE" 2>/dev/null)" || return 1
	for ip in $OTHER_IPS; do
		slowid=$((classid + SLOW_OFFSET))
		printf '%s\n' "$rules" | grep -F "ip saddr $ip" | grep -Fq "meta priority set $WAN_HANDLE:$classid" || return 1
		printf '%s\n' "$rules" | grep -F "ip saddr $ip" | grep -Fq "meta priority set $WAN_HANDLE:$slowid" || return 1
		printf '%s\n' "$rules" | grep -F "ip daddr $ip" | grep -Fq "meta priority set $LAN_HANDLE:$classid" || return 1
		printf '%s\n' "$rules" | grep -F "ip daddr $ip" | grep -Fq "meta priority set $LAN_HANDLE:$slowid" || return 1
		classid=$((classid + 1))
	done
}

wait_accounting_classifier() {
	local attempt=0
	while [ "$attempt" -lt 5 ]; do
		accounting_classifier_ok && return 0
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

save_manifest() {
	mkdir -p "$STATE_DIR" || return 1
	printf '%s\n' "$wan_if" > "$STATE_DIR/wan_if"
	printf '%s\n' "$lan_if" > "$STATE_DIR/lan_if"
	printf '%s\n' "$total_down_kbit" > "$STATE_DIR/total_down_kbit"
	printf '%s\n' "$total_up_kbit" > "$STATE_DIR/total_up_kbit"
	printf '%s\n' "$priority_down_kbit" > "$STATE_DIR/priority_down_kbit"
	printf '%s\n' "$priority_up_kbit" > "$STATE_DIR/priority_up_kbit"
	printf '%s\n' "$other_down_kbit" > "$STATE_DIR/other_down_kbit"
	printf '%s\n' "$other_up_kbit" > "$STATE_DIR/other_up_kbit"
	printf '%s\n' "$degraded_kbit" > "$STATE_DIR/degraded_kbit"
	printf '%s\n' "$OTHER_IPS" > "$STATE_DIR/other_ips"
	printf '%s\n' "$other_count" > "$STATE_DIR/other_count"
	printf '%s\n' installing > "$STATE_DIR/owned"
}

write_applied_snapshot() {
	local scope="${1:-last_apply}" tmp="$STATE_DIR/applied-snapshot.tmp" ip tab id mac down up nft_sha256 wan_tc_sha256 lan_tc_sha256 value
	case "$scope" in last_apply|safe_fallback) ;; *) return 1 ;; esac
	nft_sha256="$(shaper_nft_topology_fingerprint)" || return 1
	wan_tc_sha256="$(tc_topology_fingerprint "$wan_if")" || return 1
	lan_tc_sha256="$(tc_topology_fingerprint "$lan_if")" || return 1
	for value in "$nft_sha256" "$wan_tc_sha256" "$lan_tc_sha256"; do
		[ "${#value}" = '64' ] || return 1
		case "$value" in *[!0-9a-f]*) return 1 ;; esac
	done
	{
		printf 'applied_at=%s\n' "$(date +%s)"
		printf 'verification_scope=%s\n' "$scope"
		printf 'wan_if=%s\n' "$wan_if"
		printf 'total_down_kbit=%s\n' "$total_down_kbit"
		printf 'total_up_kbit=%s\n' "$total_up_kbit"
		printf 'other_down_kbit=%s\n' "$other_down_kbit"
		printf 'other_up_kbit=%s\n' "$other_up_kbit"
		printf 'degraded_kbit=%s\n' "$degraded_kbit"
		printf 'other_count=%s\n' "$other_count"
		printf 'nft_topology_sha256=%s\n' "$nft_sha256"
		printf 'wan_tc_topology_sha256=%s\n' "$wan_tc_sha256"
		printf 'lan_tc_topology_sha256=%s\n' "$lan_tc_sha256"
		for ip in $PRIORITY_IPS; do printf 'priority_ip=%s\n' "$ip"; done
		tab="$(printf '\t')"
		while IFS="$tab" read -r id mac ip down up; do
			if [ "$scope" = 'safe_fallback' ]; then down="$degraded_kbit"; up="$degraded_kbit"; fi
			[ -z "$id" ] || printf 'device\t%s\t%s\t%s\t%s\n' "$id" "$ip" "$down" "$up"
		done < "$DEVICES_FILE"
	} > "$tmp" && mv "$tmp" "$STATE_DIR/applied-snapshot"
}

shaper_nft_topology_fingerprint() {
	local rules
	rules="$(nft list table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null)" || return 1
	printf '%s\n' "$rules" |
		awk '{ gsub(/packets [0-9]+ bytes [0-9]+/, "packets <runtime> bytes <runtime>"); print }' |
		sha256sum | awk '{ print $1 }'
}

tc_topology_fingerprint() {
	local dev="$1" qdisc classes
	valid_iface "$dev" || return 1
	qdisc="$(tc qdisc show dev "$dev" 2>/dev/null)" || return 1
	classes="$(tc class show dev "$dev" 2>/dev/null)" || return 1
	# tc exposes packet counters in the root qdisc and unstable kernel leaf
	# identifiers in class text.  Keep every qdisc plus the real HTB classes,
	# but canonicalize those runtime-only values before hashing the topology.
	qdisc="$(printf '%s\n' "$qdisc" |
		awk '{ gsub(/direct_packets_stat [0-9]+/, "direct_packets_stat <runtime>"); print }' |
		sort)" || return 1
	classes="$(printf '%s\n' "$classes" |
		awk '/^class htb / { gsub(/ leaf [^ ]+/, " leaf <qdisc>"); print }' |
		sort)" || return 1
	[ -n "$qdisc" ] && [ -n "$classes" ] || return 1
	printf 'qdisc=%s\nclasses=%s\n' "$qdisc" "$classes" | sha256sum | awk '{ print $1 }'
}

load_manifest() {
	saved_wan="$(cat "$STATE_DIR/wan_if" 2>/dev/null)"; saved_lan="$(cat "$STATE_DIR/lan_if" 2>/dev/null)"
	saved_total_down="$(cat "$STATE_DIR/total_down_kbit" 2>/dev/null)"; saved_total_up="$(cat "$STATE_DIR/total_up_kbit" 2>/dev/null)"
	saved_priority_down="$(cat "$STATE_DIR/priority_down_kbit" 2>/dev/null)"; saved_priority_up="$(cat "$STATE_DIR/priority_up_kbit" 2>/dev/null)"
	saved_other_down="$(cat "$STATE_DIR/other_down_kbit" 2>/dev/null)"; saved_other_up="$(cat "$STATE_DIR/other_up_kbit" 2>/dev/null)"
	saved_degraded="$(cat "$STATE_DIR/degraded_kbit" 2>/dev/null)"; saved_other_ips="$(cat "$STATE_DIR/other_ips" 2>/dev/null)"
	legacy_manifest=0
	[ -n "$saved_degraded" ] || legacy_manifest=1
	valid_iface "$saved_wan" && valid_iface "$saved_lan" || return 1
	for value in "$saved_total_down" "$saved_total_up" "$saved_priority_down" "$saved_priority_up" "$saved_other_down" "$saved_other_up"; do is_uint "$value" || return 1; done
	[ "$legacy_manifest" = '1' ] || is_uint "$saved_degraded" || return 1
	for ip in $saved_other_ips; do valid_ipv4 "$ip" || return 1; done
}

legacy_ipv4_hex() {
	awk -F. '{ printf "%02x%02x%02x%02x", $1, $2, $3, $4 }' <<EOF
$1
EOF
}

legacy_filter_matches() {
	local dev="$1" handle="$2" classid="$3" direction="$4" ip="$5" offset output hex
	[ "$direction" = 'src' ] && offset=12 || offset=16
	hex="$(legacy_ipv4_hex "$ip")"
	output="$(tc filter show dev "$dev" parent "$handle:" protocol ip prio 10 2>/dev/null)" || return 1
	printf '%s\n' "$output" | awk -v flow="flowid $handle:$classid" -v key="match $hex/ffffffff at $offset" '
		/^filter / { if (has_flow && has_key) ok=1; has_flow=0; has_key=0 }
		index($0, flow) { has_flow=1 }
		index($0, key) { has_key=1 }
		END { if (has_flow && has_key) ok=1; exit !ok }'
}

verify_legacy_tree() {
	local dev="$1" handle="$2" total="$3" priority="$4" other="$5" direction="$6" root ip classid=101
	[ -d "/sys/class/net/$dev" ] || return 0
	root="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /{p;q;}')"
	case "$root" in
		''|*'qdisc fq_codel 0:'*|*'qdisc noqueue 0:'*) return 0 ;;
		*"qdisc htb $handle: root"*) ;;
		*) return 1 ;;
	esac
	class_value_matches "$dev" "$handle:1" ceil $((total * 125)) || return 1
	class_value_matches "$dev" "$handle:10" rate $((priority * 125)) || return 1
	class_value_matches "$dev" "$handle:20" rate $((other * 125)) || return 1
	for ip in $saved_other_ips; do
		class_value_matches "$dev" "$handle:$classid" rate $((other * 125)) || return 1
		legacy_filter_matches "$dev" "$handle" "$classid" "$direction" "$ip" || return 1
		classid=$((classid + 1))
	done
}

delete_owned_root() {
	local dev="$1" handle="$2" require_signature="$3" root
	[ -d "/sys/class/net/$dev" ] || return 0
	root="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /{p;q;}')"
	case "$root" in
		''|*'qdisc fq_codel 0:'*|*'qdisc noqueue 0:'*) return 0 ;;
		*"qdisc htb $handle: root"*)
			[ "$require_signature" != '1' ] || class_value_matches "$dev" "$handle:$OWNER_CLASS" rate $((BASE_RATE_KBIT * 125)) || return 1
			tc qdisc del dev "$dev" root
			;;
		*) return 1 ;;
	esac
}

clear_owned_rules() {
	local marker
	cleanup_started=0
	[ -f "$STATE_DIR/owned" ] || return 0
	marker="$(cat "$STATE_DIR/owned" 2>/dev/null)"
	case "$marker" in installing|active) ;; *) return 1 ;; esac
	load_manifest || return 1
	if [ "$marker" = 'active' ]; then
		if [ "$legacy_manifest" = '1' ]; then
			verify_legacy_tree "$saved_wan" 1 "$saved_total_up" "$saved_priority_up" "$saved_other_up" src || return 1
			cleanup_started=1
			delete_owned_root "$saved_wan" 1 0 || return 1
			verify_legacy_tree "$saved_lan" 2 "$saved_total_down" "$saved_priority_down" "$saved_other_down" dst || return 1
			delete_owned_root "$saved_lan" 2 0 || return 1
		else
			# Each signed root is independent. A vanished WAN/qdisc is already
			# removed; a surviving reserved root plus sentinel is safe to delete
			# even if another class was lost during an interface failure.
			cleanup_started=1
			delete_owned_root "$saved_wan" "$WAN_HANDLE" 1 || return 1
			delete_owned_root "$saved_lan" "$LAN_HANDLE" 1 || return 1
		fi
	else
		# A legacy interrupted install has no ownership sentinel and is left
		# untouched rather than guessing about a root qdisc.
		[ "$legacy_manifest" = '0' ] || return 1
		cleanup_started=1
		delete_owned_root "$saved_wan" "$WAN_HANDLE" 0 || return 1
		delete_owned_root "$saved_lan" "$LAN_HANDLE" 0 || return 1
	fi
	if nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1; then
		if [ "$legacy_manifest" = '1' ]; then legacy_classifier_owned || return 1; else classifier_owned || return 1; fi
		nft delete table "$TABLE_FAMILY" "$TABLE_NAME" || return 1
	fi
	rm -f "$STATE_DIR/owned"
}

rollback_new_rules() {
	local failed=0
	[ "$created_wan" != '1' ] || delete_owned_root "$wan_if" "$WAN_HANDLE" 0 >/dev/null 2>&1 || failed=1
	[ "$created_lan" != '1' ] || delete_owned_root "$lan_if" "$LAN_HANDLE" 0 >/dev/null 2>&1 || failed=1
	if [ "$created_classifier" = '1' ]; then
		classifier_owned && nft delete table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || failed=1
	fi
	[ "$failed" != '0' ] || rm -f "$STATE_DIR/owned"
	return "$failed"
}

activate_safe_fallback() {
	local reason="$1" require_accounting="${2:-1}" configured_down="$other_down_kbit" configured_up="$other_up_kbit"
	rollback_new_rules >/dev/null 2>&1
	created_wan=0; created_lan=0; created_classifier=0
	root_qdisc_free "$wan_if" && root_qdisc_free "$lan_if" || return 1
	! nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || return 1
	# Persist the effective fallback values so cleanup and RPC readback describe
	# the tree that is actually left enforcing traffic.
	other_down_kbit="$degraded_kbit"; other_up_kbit="$degraded_kbit"
	save_manifest || { other_down_kbit="$configured_down"; other_up_kbit="$configured_up"; return 1; }
	# Publish the direct priority path before either HTB root appears. The gate
	# continues blocking Otros until the complete fallback passes readback.
	install_classifier || return 1
	created_classifier=1
	install_tree_skeleton "$wan_if" "$WAN_HANDLE" "$total_up_kbit" || return 1
	install_tree_skeleton "$lan_if" "$LAN_HANDLE" "$total_down_kbit" || return 1
	verify_tree_skeleton "$wan_if" "$WAN_HANDLE" "$total_up_kbit" && verify_tree_skeleton "$lan_if" "$LAN_HANDLE" "$total_down_kbit" || return 1
	populate_tree "$wan_if" "$WAN_HANDLE" up "$degraded_kbit" || return 1
	populate_tree "$lan_if" "$LAN_HANDLE" down "$degraded_kbit" || return 1
	verify_tree "$wan_if" "$WAN_HANDLE" "$total_up_kbit" up "$degraded_kbit" &&
		verify_tree "$lan_if" "$LAN_HANDLE" "$total_down_kbit" down "$degraded_kbit" &&
		local_output_classifier_ok || return 1
	[ "$require_accounting" != '1' ] || accounting_classifier_ok || return 1
	write_applied_snapshot safe_fallback || return 1
	remove_gate || return 1
	printf '%s\n' active > "$STATE_DIR/owned"
	write_state safe "$reason Se verificó el perfil preventivo de 64 Kbit/s sólo para Otros y el bypass prioritario." || return 1
	[ "$require_accounting" != '0' ] || schedule_boot_promotion
	return 0
}

schedule_boot_promotion() {
	(
		exec 8>&-
		attempt=0
		while [ "$attempt" -lt 30 ]; do
			sleep 2
			[ "$(cat /var/run/nano-shaper/state 2>/dev/null)" = 'safe' ] || exit 0
			if [ "$(cat /var/run/nano-accounting/state 2>/dev/null)" = 'active' ]; then
				/etc/hotplug.d/dhcp/95-nano-shaper reconcile >/dev/null 2>&1
				exit $?
			fi
			attempt=$((attempt + 1))
		done
	) &
}

fail_after_clear() {
	local reason="$1"
	if ! activate_safe_fallback "$reason"; then
		rollback_new_rules >/dev/null 2>&1
		write_failure_state "$reason No se pudo verificar el perfil preventivo."
	fi
	return 1
}

write_failure_state() {
	write_state error "$1 Internet queda en el perfil seguro disponible."
}

start_service() {
	command -v tc >/dev/null 2>&1 && command -v nft >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1 || { write_failure_state 'Faltan herramientas de shaping.'; return 1; }
	acquire_tc_lock || { write_failure_state 'No se pudo obtener la exclusión para gestionar tc.'; return 1; }
	write_state applying 'Aplicando y verificando el shaping.' || return 1
	config_load bwlimit; config_get_bool enabled main enabled 0
	if [ "$enabled" != '1' ]; then
		[ ! -f "$STATE_DIR/owned" ] || clear_owned_rules || { write_failure_state 'El shaping activo no coincide con la firma propia; no se tocó.'; return 1; }
		remove_gate || { write_failure_state 'La protección transitoria propia no pudo retirarse.'; return 1; }
		write_state disabled 'Shaping desactivado.' || return 1
		return 0
	fi
	load_settings || { write_failure_state 'Configuración, interfaces o reservas prioritarias no válidas.'; return 1; }
	exclusive_tc_authority_ok || { write_failure_state 'SQM/QoS compite por las interfaces; no se modificó ningún qdisc.'; return 1; }
	ensure_offloading_disabled || { write_failure_state 'No se pudo desactivar flow offloading.'; return 1; }
	install_gate || { write_failure_state 'No se pudo instalar la protección transitoria propia.'; return 1; }
	if ! wait_accounting_classifier; then
		if [ ! -f "$STATE_DIR/owned" ]; then
			created_wan=0; created_lan=0; created_classifier=0
			activate_safe_fallback 'La contabilidad individual aún no está lista.' 0 || write_failure_state 'La contabilidad individual no está lista y no se pudo verificar el perfil preventivo.'
		else
			remove_gate || { write_failure_state 'La contabilidad no está lista y no se pudo retirar la protección transitoria.'; return 1; }
			write_failure_state 'La contabilidad individual no está lista; se conservó el shaping anterior.'
		fi
		return 1
	fi
	if [ -f "$STATE_DIR/owned" ] && ! clear_owned_rules; then
		[ "$cleanup_started" = '1' ] || remove_gate
		write_failure_state 'El shaping anterior no coincide con su manifiesto; la protección transitoria se conservó si la limpieza había comenzado.'
		return 1
	fi
	created_wan=0; created_lan=0; created_classifier=0
	root_qdisc_free "$wan_if" && root_qdisc_free "$lan_if" || { fail_after_clear 'Apareció un qdisc ajeno tras retirar el árbol anterior; no se reemplazó.'; return 1; }
	! nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || { fail_after_clear 'Apareció una tabla nft ajena tras retirar el clasificador anterior; no se reemplazó.'; return 1; }
	save_manifest || { fail_after_clear 'No se pudo guardar el manifiesto de propiedad.'; return 1; }
	# Install direct classification first so priority and router-originated
	# packets never enter the default limited class while the roots are built.
	install_classifier || { fail_after_clear 'Falló el bypass prioritario.'; return 1; }
	created_classifier=1
	install_tree_skeleton "$wan_if" "$WAN_HANDLE" "$total_up_kbit" || { fail_after_clear 'Falló el esqueleto HTB seguro de subida.'; return 1; }
	install_tree_skeleton "$lan_if" "$LAN_HANDLE" "$total_down_kbit" || { fail_after_clear 'Falló el esqueleto HTB seguro de descarga.'; return 1; }
	verify_tree_skeleton "$wan_if" "$WAN_HANDLE" "$total_up_kbit" && verify_tree_skeleton "$lan_if" "$LAN_HANDLE" "$total_down_kbit" || { fail_after_clear 'Falló el readback de los esqueletos preventivos.'; return 1; }
	populate_tree "$wan_if" "$WAN_HANDLE" up '' || { fail_after_clear 'Falló el árbol HTB de subida.'; return 1; }
	populate_tree "$lan_if" "$LAN_HANDLE" down '' || { fail_after_clear 'Falló el árbol HTB de descarga.'; return 1; }
	verify_tree "$wan_if" "$WAN_HANDLE" "$total_up_kbit" up '' && verify_tree "$lan_if" "$LAN_HANDLE" "$total_down_kbit" down '' && accounting_classifier_ok && local_output_classifier_ok || { fail_after_clear 'Falló el readback del límite individual o del bypass prioritario.'; return 1; }
	remove_gate || { write_failure_state 'El shaping quedó instalado, pero la protección transitoria no pudo retirarse.'; return 1; }
	write_applied_snapshot last_apply || { write_failure_state 'El shaping quedó instalado, pero no se pudo publicar su manifiesto aplicado.'; return 1; }
	printf '%s\n' active > "$STATE_DIR/owned"
	write_state active 'Topes individuales sólo para Otros y bypass prioritario sin techo verificados.' || return 1
}

stop_service() {
	acquire_tc_lock || { write_failure_state 'No se pudo obtener la exclusión para gestionar tc.'; return 1; }
	write_state stopping 'Retirando de forma segura el shaping propio.' || return 1
	[ ! -f "$STATE_DIR/owned" ] || clear_owned_rules || { write_failure_state 'El shaping activo no coincide con la firma propia; no se tocó.'; return 1; }
	remove_gate || { write_failure_state 'La protección transitoria propia no pudo retirarse.'; return 1; }
	write_state stopped 'Shaping detenido.' || return 1
}

reload_service() { start_service; }
